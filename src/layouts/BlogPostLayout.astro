---
// 리디자인 2026 3차: 다크 톤(rd-page). 글 frontmatter·본문 구조·JSON-LD 는 그대로
import "../assets/styles/rd-page.css";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { authors, categories } from "../data/blog";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  author: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, category, author, tags = [] } = Astro.props;
const authorInfo = authors[author];
const categoryInfo = categories[category];

const pubDateStr = pubDate.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const updatedDateStr = updatedDate?.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    "@type": "Organization",
    name: "헤세드코퍼레이션",
    url: "https://hesedhouse.net",
  },
  publisher: {
    "@type": "Organization",
    name: "헤세드코퍼레이션",
    url: "https://hesedhouse.net",
  },
});
---

<BaseLayout title={title} description={description} bodyClass="rd rd-page" ogType="article" article={{ publishedTime: pubDate.toISOString(), modifiedTime: (updatedDate || pubDate).toISOString(), author: authorInfo?.name || "헤세드코퍼레이션", tags }}>
  <Header />
  <main class="blog-post-page">
    <!-- Hero -->
    <section class="post-hero">
      <div class="post-hero-inner">
        <div class="post-meta-top">
          <a href="/blog" class="back-link">← 궁궐 서고</a>
          <span class="meta-sep">·</span>
          <span class="post-category" style={`background: ${categoryInfo?.colorLight}; color: ${categoryInfo?.color}`}>
            {categoryInfo?.label || category}
          </span>
        </div>
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        <div class="post-author-bar">
          {authorInfo && (
            <div class="author-card">
              <img src={authorInfo.image} alt={authorInfo.name} class="author-avatar" />
              <div class="author-detail">
                <span class="author-name">{authorInfo.name} <span class="author-hanja">{authorInfo.hanja}</span></span>
                <span class="author-team">{authorInfo.team} · {authorInfo.role}</span>
              </div>
            </div>
          )}
          <div class="date-info">
            <time datetime={pubDate.toISOString()}>{pubDateStr}</time>
            {updatedDateStr && <span class="updated">(수정: {updatedDateStr})</span>}
          </div>
        </div>
      </div>
    </section>

    <!-- Content -->
    <article class="post-content">
      <div class="post-content-inner">
        <slot />
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}

      <!-- Author quote -->
      {authorInfo && (
        <div class="author-quote-box" style={`border-left-color: ${categoryInfo?.color || '#00d9b8'}`}>
          <img src={authorInfo.image} alt={authorInfo.name} class="quote-avatar" />
          <div>
            <p class="quote-text">"{authorInfo.quote}"</p>
            <p class="quote-name">— {authorInfo.name} ({authorInfo.hanja}), {authorInfo.team}</p>
          </div>
        </div>
      )}

      <!-- CTA -->
      <div class="post-cta">
        <p>프로젝트 문의나 협업 제안이 있으시면 편하게 연락해 주세요.</p>
        <a href="/contact" class="cta-btn">문의하기 →</a>
      </div>
    </article>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={jsonLd} />
</BaseLayout>

<style>
  .blog-post-page {
    background: var(--bg);
    min-height: 100vh;
  }

  /* ── Hero ── */
  .post-hero {
    background: var(--bg);
    padding: calc(var(--rd-nav-h) + clamp(56px, 7vw, 104px)) var(--gut) clamp(40px, 5vw, 64px);
    color: var(--fg);
    border-bottom: 1px solid var(--line);
  }

  .post-hero-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.6);
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .meta-sep {
    color: rgba(255,255,255,0.24);
  }

  .post-category {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 12px;
    border-radius: 50px;
  }

  .post-title {
    font-size: clamp(30px, 4.2vw, 56px);
    font-weight: 740;
    line-height: 1.16;
    letter-spacing: -0.04em;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .post-description {
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.6;
    color: var(--fg2);
    margin-bottom: 36px;
  }

  .post-author-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .author-card {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255,255,255,0.15);
  }

  .author-detail {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .author-hanja {
    font-weight: 400;
    color: rgba(255,255,255,0.48);
    margin-left: 4px;
  }

  .author-team {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.48);
  }

  .date-info {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.48);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .updated {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.32);
  }

  /* ── Content ── */
  .post-content {
    max-width: calc(860px + 2 * var(--gut));
    margin: 0 auto;
    padding: clamp(40px, 5vw, 72px) var(--gut) clamp(72px, 9vw, 128px);
  }

  .post-content-inner {
    line-height: 1.9;
    font-size: 1.0625rem;
    color: #dcdbd6;
  }

  .post-content-inner :global(h2) {
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.3;
    margin-top: 56px;
    margin-bottom: 18px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    color: var(--fg);
  }

  .post-content-inner :global(h3) {
    font-size: 1.1875rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin-top: 32px;
    margin-bottom: 12px;
    color: var(--fg);
  }

  .post-content-inner :global(p) {
    margin-bottom: 16px;
  }

  .post-content-inner :global(ul),
  .post-content-inner :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .post-content-inner :global(li) {
    margin-bottom: 6px;
    list-style: disc;
  }

  .post-content-inner :global(ol li) {
    list-style: decimal;
  }

  .post-content-inner :global(strong) {
    font-weight: 650;
    color: var(--fg);
  }

  .post-content-inner :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding: 14px 22px;
    margin: 28px 0;
    background: var(--bg2);
    border-radius: 0 10px 10px 0;
    font-style: italic;
    color: var(--fg2);
  }

  .post-content-inner :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 0.875rem;
  }

  .post-content-inner :global(th) {
    background: var(--bg3);
    color: var(--fg);
    border-bottom: 1px solid var(--line2);
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
  }

  .post-content-inner :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
  }

  .post-content-inner :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content-inner :global(tr:nth-child(even)) {
    background: var(--bg2);
  }

  .post-content-inner :global(code) {
    font-size: 0.875em;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .post-content-inner :global(img) {
    border-radius: 8px;
    margin: 24px 0;
  }

  /* ── Tags ── */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
  }

  .tag {
    font-size: 0.8125rem;
    color: var(--fg2);
    background: rgba(255, 255, 255, 0.06);
    padding: 4px 12px;
    border-radius: 50px;
  }

  /* ── Author quote box ── */
  .author-quote-box {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 40px;
    padding: 24px;
    background: var(--bg2);
    border-left: 3px solid;
    border-radius: 0 12px 12px 0;
  }

  .quote-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .quote-text {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--fg2);
    font-style: italic;
    margin-bottom: 4px;
  }

  .quote-name {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* ── CTA ── */
  .post-cta {
    margin-top: 40px;
    padding: 40px 32px;
    background: linear-gradient(160deg, rgba(0, 217, 184, 0.14), var(--bg2) 62%);
    border: 1px solid rgba(0, 217, 184, 0.45);
    border-radius: 12px;
    text-align: center;
    color: rgba(255,255,255,0.8);
  }

  .post-cta p {
    font-size: 0.9375rem;
    margin-bottom: 16px;
    color: rgba(255,255,255,0.72);
  }

  .cta-btn {
    display: inline-block;
    padding: 12px 28px;
    background: var(--fg);
    color: #0a0a0a;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 50px;
    transition: background 0.15s;
  }

  .cta-btn:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .post-content-inner {
      font-size: 1rem;
    }

    .author-quote-box {
      flex-direction: column;
      text-align: center;
    }

    .date-info {
      align-items: flex-start;
    }
  }
</style>
