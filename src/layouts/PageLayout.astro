---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  transparentHeader?: boolean;
}

const { title, description, ogImage, transparentHeader = false } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <Header transparent={transparentHeader} />
  <main class:list={[{ "main--with-header-offset": !transparentHeader }]}>
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 고정 헤더 높이만큼 본문을 내린다 (rd-base.css 의 --rd-nav-h: 데스크톱 72px, 모바일 64px) */
  .main--with-header-offset {
    padding-top: var(--rd-nav-h, 72px);
  }
</style>
