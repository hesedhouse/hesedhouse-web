---
import "../assets/styles/rd-page.css";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RevealScript from "../components/RevealScript.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  transparentHeader?: boolean;
  /** "dark" = 리디자인 2026 내부 페이지 톤(rd-page.css). 생략하면 옛 밝은 본문 그대로 */
  theme?: "light" | "dark";
}

const { title, description, ogImage, transparentHeader = false, theme = "light" } = Astro.props;
const dark = theme === "dark";
---

<BaseLayout title={title} description={description} ogImage={ogImage} bodyClass={dark ? "rd rd-page" : undefined}>
  {dark && <RevealScript />}
  <Header transparent={transparentHeader} />
  <main class:list={[{ "main--with-header-offset": !transparentHeader }]}>
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 고정 헤더 높이만큼 본문을 내린다 (rd-base.css 의 --rd-nav-h: 데스크톱 72px, 모바일 64px) */
  .main--with-header-offset {
    padding-top: var(--rd-nav-h, 72px);
  }
</style>
