---
interface Props {
  title: string;
  subtitle?: string;
  buttonText: string;
  buttonHref: string;
}

const { title, subtitle, buttonText, buttonHref } = Astro.props;
---

<section class="cta">
  <div class="container cta-inner">
    <h2 class="cta-title">{title}</h2>
    {subtitle && <p class="cta-sub">{subtitle}</p>}
    <a class="cta-btn" href={buttonHref}>{buttonText}</a>
  </div>
</section>

<style>
  .cta {
    background: var(--hc-black);
    padding: 72px 0;
    text-align: center;
  }

  .cta-inner {
    max-width: 680px;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: var(--t-section-size);
    font-weight: 600;
    line-height: 1.15;
    color: var(--hc-white);
    margin-bottom: 12px;
  }

  .cta-sub {
    font-size: var(--t-body-size);
    color: var(--hc-white-80);
    line-height: 1.5;
    margin-bottom: 28px;
  }

  /* pill button */
  .cta-btn {
    display: inline-block;
    background: var(--hc-accent);
    color: var(--hc-on-accent);
    font-family: var(--font-display);
    font-size: var(--t-btn-size);
    font-weight: 600;
    padding: 14px 36px;
    border-radius: var(--r-pill);
    transition: background 0.2s var(--ease-std), transform 0.2s var(--ease-std);
    margin-top: 16px;
  }

  .cta-btn:hover {
    background: var(--hc-accent-deep);
    transform: scale(1.03);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .cta {
      padding: 56px 0;
    }

    .cta-title {
      font-size: 1.75rem;
    }
  }

  /* ── 리디자인 2026 내부 페이지 (body.rd-page): 홈 CTA 와 같은 문법 ── */
  :global(body.rd-page) .cta {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    padding: clamp(96px, 13vw, 200px) 0;
  }

  :global(body.rd-page) .cta::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(1200px, 150vw);
    height: 600px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 180, 152, 0.28), transparent);
    pointer-events: none;
  }

  :global(body.rd-page) .cta .cta-inner {
    position: relative;
    max-width: 1100px;
  }

  :global(body.rd-page) .cta .cta-title {
    font-size: clamp(34px, 6.2vw, 92px);
    font-weight: 780;
    letter-spacing: -0.05em;
    line-height: 1.02;
    color: var(--fg);
    margin-bottom: 0;
    text-wrap: balance;
  }

  :global(body.rd-page) .cta .cta-sub {
    margin: clamp(20px, 2.4vw, 32px) 0 0;
    font-size: clamp(16px, 1.5vw, 20px);
    color: var(--fg2);
  }

  :global(body.rd-page) .cta .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 28px;
    margin-top: clamp(32px, 3.6vw, 48px);
    background: var(--fg);
    color: #0a0a0a;
    font-size: 15px;
    transition: background 0.3s, color 0.3s, transform 0.25s;
  }

  :global(body.rd-page) .cta .cta-btn::after {
    content: "→";
    font-size: 16px;
  }

  :global(body.rd-page) .cta .cta-btn:hover {
    background: var(--accent);
    color: var(--on-accent);
    transform: none;
  }
</style>
