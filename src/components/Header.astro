---
// 리디자인 2026 헤더 — 모든 페이지 공용.
// transparent: 히어로 위에 투명하게 시작(스크롤 시 solid). 홈에서만 사용.
// autohide: 아래로 스크롤하면 숨고 위로 스크롤하면 다시 나타남. 홈에서만 사용.
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "../assets/styles/rd-base.css";
import { services, works } from "../data/navigation";

interface Props {
  transparent?: boolean;
  autohide?: boolean;
}

const { transparent = false, autohide = false } = Astro.props;
const isHome = Astro.url.pathname === "/";
const servicesHref = isHome ? "#services" : "/#services";

const pages = [
  { label: "ABOUT", href: "/about" },
  { label: "SERVICE", href: servicesHref, children: services },
  { label: "WORKS", href: "/works", children: works },
  { label: "BLOG", href: "/blog" },
  { label: "CONTACT", href: "/contact" },
];
---

<header
  class:list={["rd", "rd-nav", { "is-solid": !transparent }]}
  data-transparent={transparent ? "true" : "false"}
  data-autohide={autohide ? "true" : "false"}
>
  <a class="rd-logo" href="/" aria-label="HESEDCORP 홈">
    <span class="rd-logo-mark" aria-hidden="true">H</span>
    <span class="rd-logo-text">HESEDCORP<i>.</i></span>
  </a>

  <nav aria-label="주 메뉴">
    <ul class="rd-menu">
      {pages.map((p) => (
        <li>
          <a href={p.href}>{p.label}</a>
          {p.children && (
            <ul class="rd-dd">
              {p.children.map((c) => (
                <li><a href={c.href}>{c.label}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>

  <div class="rd-nav-right">
    <div class="rd-clock" aria-hidden="true">GOYANG --:--</div>
    <a class="rd-pill rd-pill--light" href="/contact">프로젝트 문의</a>
    <button class="rd-pill rd-pill--dark rd-menu-btn" type="button" aria-expanded="false" aria-controls="rdOverlay">Menu ≡</button>
  </div>
</header>

<!-- 메뉴 오버레이: header 의 backdrop-filter 가 fixed 자식을 가두므로 형제로 둔다 -->
<div class="rd rd-overlay" id="rdOverlay" aria-hidden="true">
  <div class="rd-overlay-bar">
    <a class="rd-logo" href="/" tabindex="-1">
      <span class="rd-logo-mark" aria-hidden="true">H</span>
      <span class="rd-logo-text">HESEDCORP<i>.</i></span>
    </a>
    <button class="rd-pill rd-pill--dark rd-menu-close" type="button" tabindex="-1">Close ×</button>
  </div>
  <div class="rd-overlay-body">
    <ul class="rd-overlay-main">
      {pages.map((p, i) => (
        <li><a href={p.href} tabindex="-1"><small>0{i + 1}</small>{p.label}</a></li>
      ))}
    </ul>
    <div class="rd-overlay-col">
      <h5>Services</h5>
      <ul>{services.map((s) => <li><a href={s.href} tabindex="-1">{s.label}</a></li>)}</ul>
    </div>
    <div class="rd-overlay-col">
      <h5>Works</h5>
      <ul>{works.map((w) => <li><a href={w.href} tabindex="-1">{w.label}</a></li>)}</ul>
    </div>
    <div class="rd-overlay-col">
      <h5>Contact</h5>
      <ul>
        <li><a href="tel:031-994-7740" tabindex="-1">031.994.7740</a></li>
        <li><a href="mailto:hesed@hesedhouse.net" tabindex="-1">hesed@hesedhouse.net</a></li>
        <li><a href="http://pf.kakao.com/_Kxnkxou" target="_blank" rel="noopener" tabindex="-1">카카오톡 @헤세드하우스</a></li>
        <li><a href="https://www.instagram.com/hesed.palace" target="_blank" rel="noopener" tabindex="-1">Instagram @hesed.palace</a></li>
      </ul>
    </div>
  </div>
</div>

<script>
  const nav = document.querySelector<HTMLElement>(".rd-nav");
  const overlay = document.querySelector<HTMLElement>("#rdOverlay");

  if (nav) {
    // 스크롤: 투명 → solid, (홈) 아래로 스크롤 시 숨김
    const transparent = nav.dataset.transparent === "true";
    const autohide = nav.dataset.autohide === "true";
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      if (transparent) nav.classList.toggle("is-solid", y > 60);
      if (autohide) nav.classList.toggle("is-hidden", y > 160 && y > lastY);
      lastY = y;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // 실시간 시계 (KST)
    const clock = nav.querySelector<HTMLElement>(".rd-clock");
    if (clock) {
      const fmt = new Intl.DateTimeFormat("ko-KR", { hour12: false, hour: "2-digit", minute: "2-digit", timeZone: "Asia/Seoul" });
      const tick = () => { clock.textContent = `GOYANG ${fmt.format(new Date())}`; };
      tick();
      setInterval(tick, 1000);
    }
  }

  // 메뉴 오버레이
  if (nav && overlay) {
    const openBtn = nav.querySelector<HTMLButtonElement>(".rd-menu-btn");
    const closeBtn = overlay.querySelector<HTMLButtonElement>(".rd-menu-close");
    const focusables = () => Array.from(overlay.querySelectorAll<HTMLElement>("a,button"));
    const setOpen = (open: boolean) => {
      overlay.setAttribute("aria-hidden", open ? "false" : "true");
      openBtn?.setAttribute("aria-expanded", open ? "true" : "false");
      focusables().forEach((el) => (el.tabIndex = open ? 0 : -1));
      document.documentElement.style.overflow = open ? "hidden" : "";
      // 홈의 스무스 스크롤(Lenis)이 듣는다
      window.dispatchEvent(new CustomEvent(open ? "rd:menu-open" : "rd:menu-close"));
      if (open) closeBtn?.focus(); else openBtn?.focus();
    };
    openBtn?.addEventListener("click", () => setOpen(true));
    closeBtn?.addEventListener("click", () => setOpen(false));
    overlay.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.getAttribute("aria-hidden") === "false") setOpen(false);
    });
  }
</script>
