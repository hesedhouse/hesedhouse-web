---
interface Props {
  category: 'ip' | 'merch' | 'popup' | 'distribution' | 'vs' | 'ai';
  client?: string;
  title: string;
  description?: string;
  year?: string;
  tag?: string;
  image?: string;
}

const { category, client, title, description, year, tag, image } = Astro.props;

const categoryLabels: Record<string, string> = {
  ip: 'IP LICENSE',
  merch: 'MERCHANDISE',
  popup: 'POP-UP',
  distribution: 'DISTRIBUTION',
  vs: 'VISUAL',
  ai: 'AI SOLUTION',
};

const label = tag || categoryLabels[category];
const showClient = client && client !== 'HESEDCORP';
---

<article class={`pf-tile ${image ? 'has-photo' : 'is-type'}`}>
  {image && (
    <div class="pf-photo">
      <img src={image} alt={title} loading="lazy" />
      <div class="pf-scrim" aria-hidden="true"></div>
    </div>
  )}

  <div class="pf-meta">
    <span class="pf-tag">{label}</span>
    {year && <span class="pf-yr">{year}</span>}
  </div>

  <div class="pf-bottom">
    <span class="pf-rule" aria-hidden="true"></span>
    {showClient && <span class="pf-client">{client}</span>}
    <h3 class="pf-title">{title}</h3>
    {!image && description && <p class="pf-desc">{description}</p>}
  </div>
</article>

<style>
  /* ── Tile base — self-contained dark tile ── */
  .pf-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 4 / 3;
    padding: 22px 24px;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition:
      transform 0.35s var(--ease-std),
      box-shadow 0.35s var(--ease-std),
      border-color 0.35s var(--ease-std);
  }
  .pf-tile:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.45);
  }

  /* Faint ember glow on type tiles */
  .pf-tile.is-type::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 55% at 100% 0%,
      rgba(243, 152, 0, 0.07) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  /* ── Photo layer ── */
  .pf-photo {
    position: absolute;
    inset: 0;
  }
  .pf-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-std);
  }
  .pf-tile:hover .pf-photo img {
    transform: scale(1.045);
  }
  .pf-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.30) 0%,
      rgba(10, 10, 10, 0.02) 38%,
      rgba(10, 10, 10, 0.10) 62%,
      rgba(10, 10, 10, 0.86) 100%
    );
  }

  /* ── Meta row (top) ── */
  .pf-meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .pf-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.4px;
    color: var(--hc-orange);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .has-photo .pf-tag {
    padding: 5px 10px;
    border-radius: var(--r-pill);
    background: rgba(10, 10, 10, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .pf-yr {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.38);
  }
  .has-photo .pf-yr {
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }

  /* ── Bottom block ── */
  .pf-bottom {
    position: relative;
    z-index: 1;
  }
  .pf-rule {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--hc-orange);
    margin-bottom: 14px;
    transition: width 0.35s var(--ease-std);
  }
  .pf-tile:hover .pf-rule {
    width: 52px;
  }
  .has-photo .pf-rule {
    margin-bottom: 10px;
  }

  .pf-client {
    display: block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 6px;
  }

  .pf-title {
    font-family: var(--font-display);
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: 800;
    line-height: 1.32;
    letter-spacing: -0.2px;
    color: var(--hc-white);
    margin: 0;
    word-break: keep-all;
  }
  .has-photo .pf-title {
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }

  .pf-desc {
    font-size: 13.5px;
    line-height: 1.58;
    color: rgba(255, 255, 255, 0.48);
    margin: 10px 0 0;
    word-break: keep-all;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .pf-tile {
      aspect-ratio: 16 / 11;
      padding: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-tile,
    .pf-photo img,
    .pf-rule {
      transition: none;
    }
  }
</style>
