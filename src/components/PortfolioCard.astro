---
interface Props {
  category: 'ip' | 'merch' | 'popup' | 'distribution' | 'vs' | 'ai';
  client?: string;
  title: string;
  description?: string;
  year?: string;
  tag?: string;
  image?: string;
}

const { category, client, title, description, year, tag, image } = Astro.props;

const categoryLabels: Record<string, string> = {
  ip: 'IP LICENSE',
  merch: 'MERCHANDISE',
  popup: 'POP-UP',
  distribution: 'DISTRIBUTION',
  vs: 'VISUAL',
  ai: 'AI SOLUTION',
};
---

<div class={`pf-card cat-${category}`}>
  <div class="pf-thumb">
    {image ? (
      <img class="pf-img" src={image} alt={title} loading="lazy" />
    ) : (
      <div class="pf-placeholder">
        <span class="pf-placeholder-icon">{categoryLabels[category]?.charAt(0) || '?'}</span>
      </div>
    )}
  </div>
  <div class="pf-body">
    <div class="pf-tags">
      <span class={`pf-cat-badge cat-badge-${category}`}>{tag || categoryLabels[category]}</span>
      {year && <span class="pf-year">{year}</span>}
    </div>
    {client && client !== 'HESEDCORP' && <span class="pf-client">{client}</span>}
    <h3 class="pf-title">{title}</h3>
    {description && <p class="pf-desc">{description}</p>}
  </div>
</div>

<style>
  /* ── Card ── */
  .pf-card {
    background: var(--hc-white);
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: transform 0.3s var(--ease-std), box-shadow 0.3s var(--ease-std);
  }
  .pf-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  /* ── Thumbnail ── */
  .pf-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--hc-gray-50);
  }
  .pf-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-std);
  }
  .pf-card:hover .pf-img {
    transform: scale(1.04);
  }

  /* ── Placeholder (no image) ── */
  .pf-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pf-placeholder-icon {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: rgba(0, 0, 0, 0.06);
    letter-spacing: 2px;
  }

  /* Category-specific placeholder gradients */
  .cat-ip .pf-placeholder { background: linear-gradient(135deg, #eef4fb 0%, #dce8f5 100%); }
  .cat-merch .pf-placeholder { background: linear-gradient(135deg, #f0f4f8 0%, #e2eaf3 100%); }
  .cat-popup .pf-placeholder { background: linear-gradient(135deg, #f5f0f8 0%, #ece4f3 100%); }
  .cat-distribution .pf-placeholder { background: linear-gradient(135deg, #eef8f5 0%, #dcf0e8 100%); }
  .cat-vs .pf-placeholder { background: linear-gradient(135deg, #f3eff8 0%, #e8dff5 100%); }
  .cat-ai .pf-placeholder { background: linear-gradient(135deg, #eef6fb 0%, #dcedf8 100%); }

  .cat-ip .pf-placeholder-icon { color: rgba(0, 54, 104, 0.10); }
  .cat-merch .pf-placeholder-icon { color: rgba(0, 54, 104, 0.10); }
  .cat-popup .pf-placeholder-icon { color: rgba(100, 40, 120, 0.10); }
  .cat-distribution .pf-placeholder-icon { color: rgba(20, 100, 70, 0.10); }
  .cat-vs .pf-placeholder-icon { color: rgba(80, 40, 120, 0.10); }
  .cat-ai .pf-placeholder-icon { color: rgba(0, 80, 140, 0.10); }

  /* ── Body ── */
  .pf-body {
    padding: 20px 22px 24px;
  }

  /* ── Tags row ── */
  .pf-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .pf-cat-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 4px 10px;
    border-radius: 6px;
    line-height: 1;
  }
  /* Badge colors by category */
  .cat-badge-ip { background: rgba(0, 54, 104, 0.08); color: var(--hc-navy); }
  .cat-badge-merch { background: rgba(243, 152, 0, 0.10); color: #b06e00; }
  .cat-badge-popup { background: rgba(168, 85, 247, 0.10); color: #6b21a8; }
  .cat-badge-distribution { background: rgba(52, 211, 153, 0.10); color: #047857; }
  .cat-badge-vs { background: rgba(244, 114, 182, 0.10); color: #9d174d; }
  .cat-badge-ai { background: rgba(0, 102, 204, 0.10); color: #0052a3; }

  .pf-year {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-tertiary);
  }

  /* ── Client ── */
  .pf-client {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: var(--hc-orange);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  /* ── Title ── */
  .pf-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--fg-primary);
    margin: 0 0 8px;
    word-break: keep-all;
  }

  /* ── Description ── */
  .pf-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
