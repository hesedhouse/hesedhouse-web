---
// 리디자인 2026 푸터 — 모든 페이지 공용. 스타일은 rd-base.css (.rd-footer*)
import "../assets/styles/rd-base.css";
import { services } from "../data/navigation";

const year = new Date().getFullYear();
---

<footer class="rd rd-footer">
  <div class="rd-footer-top">
    <div class="rd-footer-brand">
      <a class="rd-logo" href="/" aria-label="HESEDCORP 홈">
        <span class="rd-logo-mark" aria-hidden="true">H</span>
        <span class="rd-logo-text">HESEDCORP<i>.</i></span>
      </a>
      <p>
        헤세드코퍼레이션 · 대표 이현우<br />
        경기도 고양시 일산서구 덕이로 24, B103<br />
        사업자등록번호 102-81-48503
      </p>
    </div>
    <div>
      <h5>Pages</h5>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/#services">Service</a></li>
        <li><a href="/works">Works</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <h5>Services</h5>
      <ul>
        {services.map((s) => (
          <li><a href={s.href}>{s.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h5>Contact</h5>
      <ul>
        <li><a href="tel:031-994-7740">031.994.7740</a></li>
        <li><a href="mailto:hesed@hesedhouse.net">hesed@hesedhouse.net</a></li>
        <li><a href="http://pf.kakao.com/_Kxnkxou" target="_blank" rel="noopener">카카오톡 @헤세드하우스</a></li>
        <li><a href="https://www.instagram.com/hesed.palace" target="_blank" rel="noopener">Instagram @hesed.palace</a></li>
        <li><a href="/contact">프로젝트 문의 →</a></li>
      </ul>
    </div>
  </div>
  <div class="rd-footer-big" aria-hidden="true">HESEDCORP.</div>
  <div class="rd-footer-bottom">
    <span>© {year} HESEDCORP. All rights reserved.</span>
    <span>Goyang, Korea · Since 2016</span>
  </div>
</footer>

<script>
  // 푸터 진입 리빌 (워드마크가 아래에서 올라옴). JS가 없으면 그대로 보인다.
  const footer = document.querySelector<HTMLElement>(".rd-footer");
  if (footer && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    footer.classList.add("rd-io");
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          footer.classList.add("is-in");
          io.disconnect();
        }
      },
      { rootMargin: "0px 0px -18% 0px" },
    );
    io.observe(footer);
  }
</script>
