---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import CTABanner from '../components/CTABanner.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
---
<PageLayout title="WORKS - POP-UP OPERATION" description="헤세드코퍼레이션의 팝업스토어 및 현장 운영 프로젝트 포트폴리오">
  <Hero dark={false} eyebrow="WORKS" title="POP-UP OPERATION" subtitle="팝업스토어 및 현장 운영 프로젝트" />
  <section class="portfolio">
    <div class="portfolio-inner">
      <div class="portfolio-grid">
        <PortfolioCard
          category="popup"
          client="Client A"
          title="캐릭터 팝업스토어 운영"
          year="2026"
        />
        <PortfolioCard
          category="popup"
          client="Client B"
          title="콘서트 현장 굿즈 판매 운영"
          year="2026"
        />
      </div>
      <p class="coming-soon">More projects coming soon.</p>
    </div>
  </section>
  <CTABanner title="프로젝트를 함께 만들어요" buttonText="CONTACT US" buttonHref="/contact" />
</PageLayout>
<style>
  .portfolio { padding: 72px 20px; }
  .portfolio-inner { max-width: var(--content-max); margin: 0 auto; }
  .portfolio-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .coming-soon { text-align: center; color: rgba(0,0,0,0.32); font-size: 14px; margin-top: 48px; }
  @media (max-width: 768px) { .portfolio-grid { grid-template-columns: 1fr; } }
</style>
