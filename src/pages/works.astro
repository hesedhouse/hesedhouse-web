---
import PageLayout from '../layouts/PageLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { getCollection } from 'astro:content';

const tabs = [
  { key: 'all', label: '전체' },
  { key: 'ip', label: 'IP 라이선스' },
  { key: 'merch', label: '굿즈 제작' },
  { key: 'popup', label: '팝업·이벤트' },
  { key: 'distribution', label: '유통' },
  { key: 'vs', label: '비주얼' },
  { key: 'ai', label: 'AI 솔루션' },
];

const all = (await getCollection('portfolio'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const totalProjects = all.length;
const years = all.map((p) => Number(p.data.year)).filter((y) => y > 0);
const yearRange = `${Math.min(...years)}–${Math.max(...years)}`;
---

<PageLayout title="WORKS — 포트폴리오" description="헤세드코퍼레이션 포트폴리오 — IP 라이선스, 굿즈 제작, 팝업 운영, 유통, 비주얼, AI 솔루션">

  <!-- Hero -->
  <section class="works-hero">
    <div class="works-inner">
      <p class="hero-index">WORKS — PROJECT ARCHIVE</p>
      <h1 class="hero-title">IP를 실물로,<br />아이디어를 서비스로.</h1>
      <p class="hero-sub">굿즈 제작과 팝업 운영부터 AI 서비스까지 — 헤세드코퍼레이션이 실제로 만들고 운영한 프로젝트들입니다.</p>
      <p class="hero-meta"><strong>{totalProjects}</strong> PROJECTS · {yearRange}</p>
    </div>
  </section>

  <!-- Filter Tabs + Grid -->
  <section class="works-main">
    <div class="works-inner">

      <!-- Tab Bar -->
      <div class="tab-bar" role="tablist">
        {tabs.map((t, i) => (
          <button
            class={`tab-btn${i === 0 ? ' is-active' : ''}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-filter={t.key}
          >
            {t.label}
            <span class="tab-count">
              {t.key === 'all' ? all.length : all.filter(p => p.data.category === t.key).length}
            </span>
          </button>
        ))}
      </div>

      <!-- Portfolio Grid -->
      <div class="pf-grid" id="pfGrid">
        {all.map((item) => (
          <div class="pf-grid-item" data-category={item.data.category}>
            <PortfolioCard
              category={item.data.category}
              client={item.data.client}
              title={item.data.title}
              description={item.data.description}
              year={item.data.year}
              tag={item.data.tag || undefined}
              image={item.data.image}
            />
          </div>
        ))}
      </div>

      <!-- Empty state -->
      <div class="pf-empty" id="pfEmpty" style="display:none;">
        <p>해당 카테고리에 등록된 프로젝트가 없습니다.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABanner
    title="다음 프로젝트, 함께 만들어요"
    subtitle="IP 기획부터 굿즈 제작, 팝업 운영, AI 서비스까지 — 헤세드가 함께합니다."
    buttonText="프로젝트 문의하기"
    buttonHref="/contact"
  />
</PageLayout>

<!-- Tab Filter Script -->
<script>
  (function initTabFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const items = document.querySelectorAll<HTMLElement>('.pf-grid-item');
    const empty = document.getElementById('pfEmpty');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter!;

        buttons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        let visibleCount = 0;
        items.forEach((item) => {
          const cat = item.dataset.category;
          const show = filter === 'all' || cat === filter;
          if (show) {
            item.style.display = '';
            item.style.animation = 'fadeUp 0.35s ease forwards';
            item.style.animationDelay = `${visibleCount * 0.04}s`;
            visibleCount++;
          } else {
            item.style.display = 'none';
            item.style.animation = '';
          }
        });

        if (empty) {
          empty.style.display = visibleCount === 0 ? '' : 'none';
        }
      });
    });
  })();
</script>

<style>
  /* ── Shared container ── */
  .works-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Hero — dark archive header ── */
  .works-hero {
    padding: 108px 24px 20px;
    background: #0a0a0a;
  }
  .hero-index {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 2.4px;
    color: var(--hc-orange);
    margin: 0 0 20px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: -1px;
    color: #ffffff;
    margin: 0 0 18px;
    word-break: keep-all;
  }
  .hero-sub {
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    max-width: 560px;
    margin: 0 0 36px;
    word-break: keep-all;
  }
  .hero-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.6px;
    color: rgba(255, 255, 255, 0.38);
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    margin: 0;
  }
  .hero-meta strong {
    color: var(--hc-orange);
    font-weight: 700;
    font-size: 14px;
  }

  /* ── Main ── */
  .works-main {
    padding: 36px 24px 88px;
    background: #0a0a0a;
  }

  /* ── Tab Bar ── */
  .tab-bar {
    display: flex;
    gap: 4px;
    padding: 5px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--r-pill);
    margin-bottom: 36px;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .tab-bar::-webkit-scrollbar { display: none; }

  .tab-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.48);
    background: transparent;
    border: none;
    border-radius: var(--r-pill);
    cursor: pointer;
    transition: all 0.25s var(--ease-std);
    white-space: nowrap;
  }
  .tab-btn:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.06);
  }
  .tab-btn:focus-visible {
    outline: 2px solid var(--hc-orange);
    outline-offset: 2px;
  }
  .tab-btn.is-active {
    color: #0a0a0a;
    background: #ffffff;
  }
  .tab-count {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--hc-orange);
  }

  /* ── Grid ── */
  .pf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .pf-grid-item {
    animation: fadeUp 0.4s ease forwards;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Empty state ── */
  .pf-empty {
    text-align: center;
    padding: 80px 20px;
    color: rgba(255, 255, 255, 0.35);
    font-size: 15px;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .pf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .works-hero { padding: 88px 20px 16px; }
    .works-main { padding: 28px 20px 64px; }
    .hero-sub { font-size: 0.95rem; margin-bottom: 28px; }
  }
  @media (max-width: 640px) {
    .pf-grid { grid-template-columns: 1fr; gap: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-grid-item { animation: none; }
    .tab-btn { transition: none; }
  }
</style>
