---
// 홈 — 리디자인 2026. 시안: 10_공용자산/웹사이트_소스/hesedcorp-homepage-2026/design
// 스타일 rd-home.css · 모션 scripts/redesign/home.js · 콘텐츠 data/home.ts
import "../assets/styles/rd-home.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import {
  homeServices, rotatingWords, introKeywords, marqueeWords, workCategoryLabels,
  homeStats, homeProcess, homePartners, partnersArePlaceholder, homeFaq, contactLinks,
  partnerCount, sinceYear,
} from "../data/home";

// 작업 아카이브: 포트폴리오 컬렉션에서 공개 항목을 order 순으로 8개
const works = (await getCollection("portfolio"))
  .filter((p) => !p.data.draft && p.data.image)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 8);
const tallPattern = [true, false, true, false, false, true, false, true];
const pad = (n: number, len: number) => String(n).padStart(len, "0");
const marquee = [...marqueeWords, ...marqueeWords.slice(0, 2)];
---

<BaseLayout
  title="HESEDCORP. | AI-Powered Business Partner"
  description="AI를 기반으로 IP 비즈니스, 콘텐츠, 커머스를 설계하는 기업, 헤세드코퍼레이션"
  bodyClass="rd rd-home"
>
  <script is:inline slot="head">
    // 모션을 쓸 수 있는 환경에서만 "처음엔 숨김" 상태를 건다. 6초 안에 모션 스크립트가 못 뜨면 전부 보이게 되돌린다.
    (function () {
      var d = document.documentElement, m = window.matchMedia;
      if (m("(prefers-reduced-motion: reduce)").matches) return;
      d.classList.add("rd-js", "rd-intro");
      if (m("(min-width: 901px)").matches && m("(hover: hover) and (pointer: fine)").matches) d.classList.add("rd-3d");
      setTimeout(function () {
        if (!window.__rdReady) d.classList.remove("rd-js", "rd-intro", "rd-3d");
      }, 6000);
    })();
  </script>

  <div class="pre" id="pre" aria-hidden="true">
    <div class="lbl">HESEDCORP. / LOADING</div>
    <div class="cnt" id="preCnt">0</div>
  </div>

  <Header transparent autohide />

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow"></div>
      <div class="streaks" aria-hidden="true">
        <span class="streak" style="left:5%;top:14%;width:220px"></span>
        <span class="streak soft" style="left:40%;top:9%;width:420px"></span>
        <span class="streak a" style="left:62%;top:22%;width:300px"></span>
        <span class="streak soft" style="left:10%;top:72%;width:520px"></span>
        <span class="streak" style="left:70%;top:84%;width:260px"></span>
        <span class="streak a" style="left:30%;top:92%;width:180px"></span>
      </div>

      <div class="hero-copy">
        <div class="eyebrow">AI Business Partner · Since 2016</div>
        <h1 class="hero-title">AI로<br />비즈니스를<br /><span class="l2">설계합니다<span class="dot">.</span></span></h1>
        <p class="hero-sub">10년의 현장 감각<span class="dot">.</span> <span class="acc">AI의 속도.</span></p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="/contact">프로젝트 문의 <span class="arr">→</span></a>
          <a class="btn btn--ghost" href="#services">서비스 살펴보기</a>
        </div>
      </div>

      <div class="obj" aria-hidden="true"><div class="rim"></div><div class="cube"></div><div class="shadow"></div></div>

      <a class="hero-side" href="/ai-solution" aria-label="AI Solution 바로가기">
        <div class="tab">H.</div>
        <div class="tab2"><span>AI SOLUTION</span></div>
      </a>

      <div class="hero-meta">
        <div class="scroll"><i></i><span class="mono">Scroll</span></div>
        <span class="mono est">Est. 2016 · Goyang, Korea · Working with IP, Goods &amp; AI</span>
      </div>
    </section>

    <!-- SERVICE INDEX -->
    <div class="wrap">
      <div class="svc-index">
        {homeServices.map((s) => (
          <a class="item" href={`#svc-${s.num}`} data-svc={s.num}>
            <span class={`ico ${s.ico}`}><b></b></span>
            <span><span class="num">{s.num}</span><span class="name">{s.short}</span></span>
          </a>
        ))}
      </div>
    </div>

    <!-- INTRO -->
    <section class="section wrap intro-sec">
      <div class="intro">
        <div class="intro-left">
          <div>
            <div class="eyebrow">About HESEDCORP</div>
            <div class="chip-row"><span class="chip">현장 경험 10년</span><span class="chip">AI 속도</span><span class="chip">하나의 창구</span></div>
          </div>
        </div>
        <div class="intro-right">
          <h2 class="h-section">하나의 팀이<br /><span class="dim">당신의</span> <span class="acc rot" data-words={rotatingWords.join(",")}>{rotatingWords[0]}</span> 모양이 됩니다.</h2>
          <p class="lead">IP 라이선스 확보부터 굿즈 기획·생산, 온·오프라인 유통, 팝업 운영, 비주얼 콘텐츠, AI 자동화까지. 7개 서비스가 하나의 생태계로 연결되어 있어, 여러 업체를 오가는 대신 HESEDCORP 한 곳과 이야기하면 됩니다.</p>
          <div class="kw-list">
            {introKeywords.map((k, i) => <span class={i % 2 === 0 ? "on" : undefined}>{k}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURE VISUAL (PLACEHOLDER: 실제 프로젝트 사진·영상으로 교체 예정) -->
    <section class="wrap feature">
      <div class="frame">
        <div class="band"></div><div class="band b"></div><div class="band c"></div>
        <div class="cap"><span class="mono">Fig. 01 · Pop-up Store</span><span class="mono">Field Record</span></div>
        <div class="cap2"><span class="mono">00:00:12</span></div>
        <div class="title">기획부터 운영까지<span class="dot">.</span><br />한 번에.</div>
        <div class="cap3"><span class="mono">실제 프로젝트 사진 또는 영상으로 교체 · 현장 기록</span></div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="section wrap services" id="services">
      <div class="head">
        <div>
          <div class="eyebrow mb">Services</div>
          <h2 class="h-section">7가지 방식으로<br />함께 일합니다<span class="dot">.</span></h2>
        </div>
        <p class="lead">각 서비스는 단독으로도, 함께 묶어서도 진행합니다. IP 하나로 굿즈·유통·팝업까지 이어지는 흐름을 한 팀이 설계합니다.</p>
      </div>
      <div class="svc-list">
        {homeServices.map((s) => (
          <a class:list={["svc-row", { hl: s.highlight }]} href={s.href} id={`svc-${s.num}`} data-label={s.en}>
            <div class="num">{s.num}</div>
            <div class="ttl">{s.title}<small>{s.en}</small></div>
            <div class="desc">{s.desc}</div>
            <div class="go" aria-hidden="true">→</div>
          </a>
        ))}
      </div>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="mq-wrap">
        <div class="mq-track">
          {marquee.map((w, i) => (<><span class={i % 2 === 1 ? "o" : undefined}>{w}</span><i></i></>))}
        </div>
      </div>
    </div>

    <!-- WORKS -->
    <section class="section wrap works">
      <div class="head">
        <div>
          <div class="eyebrow mb">Works · Archive</div>
          <h2 class="h-section">아이디어가<br />형태를 갖춥니다<span class="dot">.</span></h2>
        </div>
        <a class="btn btn--ghost" href="/works">전체 작업 보기 →</a>
      </div>
      <div class="works-grid">
        {works.map((w, i) => (
          <a class:list={["work", { tall: tallPattern[i] }]} href="/works">
            <div class="thumb">
              <img src={w.data.image} alt={w.data.title} loading="lazy" decoding="async" />
              <span class="tag">{workCategoryLabels[w.data.category]}</span>
              <span class="idx">{pad(i + 1, 3)}</span>
            </div>
            <div class="cap"><b>{w.data.title}</b><span>{w.data.year}</span></div>
          </a>
        ))}
      </div>
    </section>

    <!-- PARTNERS (PLACEHOLDER: data/home.ts 의 homePartners 를 실제 파트너사로 교체) -->
    <section class="section flush wrap partners">
      <div class="head">
        <div>
          <div class="eyebrow mb">Partners</div>
          <h2 class="h-section">함께한<br />파트너<span class="dot">.</span></h2>
        </div>
        <p class="lead">IP 홀더, 유통사, 리테일, 플랫폼까지. {sinceYear}년부터 {partnerCount}개가 넘는 파트너와 프로젝트를 함께했습니다.</p>
      </div>
      <div class="partner-grid">
        {homePartners.map((p, i) => (
          <div class="partner">
            <span class="ind">{p.industry}</span>
            <span class="idx">{pad(i + 1, 2)}</span>
            <span class="mark">{p.logo ? <img src={p.logo} alt={p.name ?? ""} loading="lazy" /> : <><i></i>{p.name ?? "PARTNER"}</>}</span>
          </div>
        ))}
      </div>
      <div class="note">
        <span class="mono">{partnersArePlaceholder ? `로고 ${homePartners.length}개 · 실제 파트너사 로고로 교체 예정` : ""}</span>
        <span class="mono">{partnerCount}+ partners · {sinceYear}–2026</span>
      </div>
    </section>

    <!-- STATS -->
    <section class="section flush wrap stats">
      <div class="head">
        <div class="eyebrow mb">Studio</div>
        <h2 class="h-section">2016년부터<span class="dot">.</span><br /><span class="dim">하나의 창구로.</span></h2>
      </div>
      <div class="stat-grid">
        {homeStats.map((s) => (
          <div class="stat"><div class="v" data-count={s.value}>{s.value}<sup>+</sup></div><div class="k">{s.label}</div></div>
        ))}
        <div class="stat acc"><div class="v">10년의 현장,<br />하나의 담당자.</div><div class="k">SINCE 2016 · GOYANG</div></div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="section flush wrap process">
      <div class="head">
        <div>
          <div class="eyebrow mb">Process</div>
          <h2 class="h-section">사람이 방향을 잡고<span class="dot">,</span><br />AI가 속도를 냅니다<span class="dot">.</span></h2>
        </div>
        <p class="lead">기획·검수·커뮤니케이션은 10년 차 담당자가, 리서치·시안·문서·반복 업무는 AI 에이전트가 맡습니다. 결과물의 품질은 사람이 책임집니다.</p>
      </div>
      <div class="proc-grid">
        {homeProcess.map((p) => (
          <div class="proc">
            <div class:list={["ico", { a: p.accent }]}><b></b></div>
            <div><div class="n">{p.n}</div><div class="t">{p.title}<small>{p.en}</small></div></div>
            <div class="d">{p.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- COMPARE -->
    <section class="section flush wrap compare">
      <div class="head">
        <div class="eyebrow mb">Why HESEDCORP</div>
        <h2 class="h-section">전달이 아니라<span class="dot">,</span><br /><span class="dim">오케스트레이션.</span></h2>
      </div>
      <div class="cmp-grid">
        <div class="cmp">
          <h4><span>일반적인 방식</span><span>5~10개 업체</span></h4>
          <div class="flow">
            <div class="node you">클라이언트 <em>YOU</em></div>
            <div class="arrow">↓ ↓ ↓</div>
            <div class="row"><div class="node">라이선스 대행</div><div class="node">굿즈 공장</div><div class="node">디자인 스튜디오</div></div>
            <div class="row"><div class="node">유통사</div><div class="node">팝업 운영사</div><div class="node">영상 제작사</div></div>
            <div class="row"><div class="node">마케팅</div><div class="node">개발사</div><div class="node">회계·정산</div></div>
          </div>
          <p>각 업체와 따로 계약하고, 따로 회의하고, 따로 정산합니다. 일정이 어긋나면 책임 소재가 흐려집니다.</p>
        </div>
        <div class="cmp me">
          <h4><span>HESEDCORP 방식</span><span>1개의 창구</span></h4>
          <div class="flow">
            <div class="node you">클라이언트 <em>YOU</em></div>
            <div class="arrow">↓</div>
            <div class="node hub">HESEDCORP 담당자 + AI 에이전트 <em>ONE CONTACT</em></div>
            <div class="arrow">↓ ↓ ↓</div>
            <div class="row"><div class="node">IP · 콜라보</div><div class="node">굿즈 · MD</div><div class="node">유통 · 해외</div></div>
            <div class="row"><div class="node">팝업 · 전시</div><div class="node">비주얼</div><div class="node">AI · 투자</div></div>
          </div>
          <p>계약도, 회의도, 정산도 한 곳. 7개 서비스를 한 팀이 조율하니 일정과 품질을 끝까지 책임집니다.</p>
        </div>
      </div>
    </section>

    <!-- FAQ (placeholder 답변은 화면에 "(예시 문구)" 로 표시됨) -->
    <section class="section flush wrap">
      <div class="faq">
        <div>
          <div class="eyebrow mb">FAQ</div>
          <h2 class="h-section">알아두면<br />좋은 것들<span class="dot">.</span></h2>
          <p class="lead">더 궁금한 점은 카카오톡 @헤세드하우스 또는 031.994.7740으로 문의하세요.</p>
        </div>
        <div class="faq-list">
          {homeFaq.map((f, i) => (
            <div class="faq-item">
              <button class="q" type="button" aria-expanded="false" aria-controls={`faq-a-${i}`}><span>{f.q}</span><span class="pm" aria-hidden="true">+</span></button>
              <div class="a" id={`faq-a-${i}`}>{f.a}{f.placeholder && <em class="ph">(예시 문구)</em>}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="glow"></div>
      <div class="streaks" aria-hidden="true">
        <span class="streak soft" style="left:8%;top:30%;width:300px"></span>
        <span class="streak a" style="left:70%;top:70%;width:260px"></span>
        <span class="streak" style="left:20%;top:80%;width:160px"></span>
      </div>
      <h2>다음 프로젝트<span class="dot">,</span><br />함께 설계합시다<span class="dot">.</span></h2>
      <p>간단한 메모만 남겨도 됩니다. 담당자가 1영업일 안에 연락드립니다.</p>
      <div class="actions">
        <a class="btn btn--primary" href="/contact">프로젝트 문의 →</a>
        <a class="btn btn--ghost" href={contactLinks.kakao} target="_blank" rel="noopener">카카오톡 @헤세드하우스</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import "../scripts/redesign/home.js";
</script>
