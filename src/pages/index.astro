---
import PageLayout from "../layouts/PageLayout.astro";
import LogoIntro from "../components/LogoIntro.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABanner from "../components/CTABanner.astro";

const services = [
  {
    eyebrow: "01",
    title: "IP LICENSE & COLLABO",
    description: "IP 라이선스 확보부터 브랜드 콜라보레이션까지, 최적의 파트너십을 설계합니다.",
    href: "/iplicensecollabo",
  },
  {
    eyebrow: "02",
    title: "MERCHANDISING",
    description: "트렌디한 굿즈와 MD 상품을 기획, 디자인, 생산합니다.",
    href: "/merchandising",
  },
  {
    eyebrow: "03",
    title: "DISTRIBUTION",
    description: "온·오프라인 유통 채널을 통해 글로벌 마켓에 진출합니다.",
    href: "/distribution",
  },
  {
    eyebrow: "04",
    title: "POP-UP OPERATION",
    description: "팝업스토어, 전시, 이벤트의 기획부터 운영까지 원스톱으로.",
    href: "/popupoperation",
  },
  {
    eyebrow: "05",
    title: "VISUAL STUDIO",
    description: "브랜드 아이덴티티를 완성하는 비주얼 콘텐츠를 제작합니다.",
    href: "/visualstudio",
  },
  {
    eyebrow: "06",
    title: "AI SOLUTION",
    description: "AI로 업무를 설계하고, 비즈니스를 자동화합니다. AI 여론 리서치 서비스 MindScope Korea를 운영합니다.",
    href: "/ai-solution",
    accent: true,
  },
  {
    eyebrow: "07",
    title: "INVESTMENT & BIZ DEV",
    description: "IP·콘텐츠·테크 분야의 성장 가능성을 발굴하고, 전략적 투자와 사업개발로 가치를 만듭니다.",
    href: "/investment",
    accent: true,
  },
];
---

<PageLayout
  title="HESEDCORP. | AI-Powered IP Business Partner"
  description="AI와 IP 비즈니스를 결합하여 콘텐츠의 가치를 극대화하는 기업, 헤세드코퍼레이션"
  transparentHeader
>
  <LogoIntro />

  <!-- ── Custom CSS Hero ── -->
  <section class="hero-main">
    <!-- Background layers -->
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>
    <div class="hero-orb hero-orb--orange"></div>
    <div class="hero-orb hero-orb--blue"></div>
    <div class="hero-line hero-line--1"></div>
    <div class="hero-line hero-line--2"></div>
    <div class="hero-line hero-line--3"></div>

    <!-- Content -->
    <div class="hero-content">
      <p class="hero-eyebrow">HESEDCORP.</p>
      <h1 class="hero-title">
        <span class="hero-title-line">IP 비즈니스를</span>
        <span class="hero-title-line">AI로 <span class="hero-accent">설계</span>합니다</span>
      </h1>
      <p class="hero-subtitle">라이선스부터 굿즈 제작, 유통, 팝업 운영까지 — AI가 함께하는 IP 비즈니스 풀체인</p>
      <div class="hero-actions">
        <a class="hero-btn hero-btn--primary" href="/contact">프로젝트 문의</a>
        <a class="hero-btn hero-btn--ghost" href="/ai-solution">AI Solution →</a>
      </div>

      <!-- Stats bar -->
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">500<span class="stat-plus">+</span></span>
          <span class="stat-label">프로젝트</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">50<span class="stat-plus">+</span></span>
          <span class="stat-label">파트너사</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">10<span class="stat-plus">+</span></span>
          <span class="stat-label">AI 에이전트</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">3<span class="stat-plus">yr</span></span>
          <span class="stat-label">IP 비즈니스</span>
        </div>
      </div>
    </div>
  </section>

  <section class="services-section">
    <div class="services-inner">
      <h2 class="services-title">Services</h2>
      <div class="services-grid">
        {services.map((s) => (
          <ServiceCard
            eyebrow={s.eyebrow}
            title={s.title}
            description={s.description}
            href={s.href}
            accent={s.accent ?? false}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    title="프로젝트를 함께 시작하세요"
    subtitle="IP 비즈니스의 A to Z, 헤세드코퍼레이션이 함께합니다."
    buttonText="CONTACT US"
    buttonHref="/contact"
  />
</PageLayout>

<style>
  /* ============================================
     HERO — CSS-only premium dark hero
     ============================================ */
  .hero-main {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0 20px;
  }

  /* ── Dark gradient background ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 40%, #0a1628 0%, transparent 70%),
      linear-gradient(180deg, #000810 0%, #001a33 40%, #002547 70%, #000a14 100%);
    z-index: 0;
  }

  /* ── Dot grid overlay ── */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.12;
    background-image: radial-gradient(circle 1px at center, rgba(255,255,255,0.5) 0%, transparent 100%);
    background-size: 32px 32px;
  }

  /* ── Floating orbs ── */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 1;
    animation: orbFloat 8s ease-in-out infinite alternate;
  }
  .hero-orb--orange {
    width: 500px;
    height: 500px;
    top: -10%;
    right: -5%;
    background: radial-gradient(circle, rgba(243, 152, 0, 0.18) 0%, transparent 70%);
    animation-duration: 10s;
  }
  .hero-orb--blue {
    width: 400px;
    height: 400px;
    bottom: -5%;
    left: -8%;
    background: radial-gradient(circle, rgba(41, 128, 185, 0.15) 0%, transparent 70%);
    animation-duration: 12s;
    animation-delay: -4s;
  }

  @keyframes orbFloat {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, -20px) scale(1.1); }
  }

  /* ── Geometric accent lines ── */
  .hero-line {
    position: absolute;
    z-index: 1;
    opacity: 0.06;
    pointer-events: none;
  }
  .hero-line--1 {
    top: 18%;
    left: 5%;
    width: 200px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(243,152,0,0.8), transparent);
    transform: rotate(-15deg);
  }
  .hero-line--2 {
    bottom: 25%;
    right: 8%;
    width: 300px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
    transform: rotate(20deg);
  }
  .hero-line--3 {
    top: 55%;
    left: 12%;
    width: 150px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(41,128,185,0.7), transparent);
    transform: rotate(-8deg);
  }

  /* ── Content ── */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    text-align: center;
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hc-orange);
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeInUp 0.8s ease 0.2s forwards;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 3.8rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #fff;
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeInUp 0.8s ease 0.4s forwards;
  }
  .hero-title-line {
    display: block;
  }
  .hero-accent {
    color: var(--hc-orange);
    position: relative;
  }
  .hero-accent::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--hc-orange);
    opacity: 0.4;
    border-radius: 2px;
  }

  .hero-subtitle {
    font-family: var(--font-text);
    font-size: 1.15rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.58);
    max-width: 560px;
    margin: 0 auto 36px;
    opacity: 0;
    animation: fadeInUp 0.8s ease 0.6s forwards;
  }

  /* ── CTA buttons ── */
  .hero-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    margin-bottom: 56px;
    opacity: 0;
    animation: fadeInUp 0.8s ease 0.8s forwards;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 32px;
    border-radius: var(--r-pill);
    transition: all 0.25s var(--ease-std);
  }
  .hero-btn--primary {
    background: var(--hc-orange);
    color: #fff;
  }
  .hero-btn--primary:hover {
    background: var(--hc-orange-deep);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(243, 152, 0, 0.3);
  }
  .hero-btn--ghost {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
  }
  .hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-2px);
  }

  /* ── Stats bar ── */
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--r-lg);
    padding: 20px 8px;
    backdrop-filter: blur(12px);
    opacity: 0;
    animation: fadeInUp 0.8s ease 1.0s forwards;
  }
  .stat {
    flex: 1;
    text-align: center;
    padding: 0 20px;
  }
  .stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }
  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
  }
  .stat-plus {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--hc-orange);
  }
  .stat-label {
    display: block;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.42);
    letter-spacing: 0.5px;
    margin-top: 4px;
  }

  /* ── Animation ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-main {
      min-height: 100svh;
      padding: 0 16px;
    }
    .hero-title {
      font-size: 2.4rem;
      letter-spacing: -0.5px;
    }
    .hero-subtitle {
      font-size: 1rem;
    }
    .hero-actions {
      flex-direction: column;
      gap: 10px;
    }
    .hero-btn {
      width: 100%;
      justify-content: center;
    }
    .hero-stats {
      flex-wrap: wrap;
      gap: 0;
      padding: 16px 8px;
    }
    .stat {
      padding: 0 12px;
      min-width: 0;
    }
    .stat-num {
      font-size: 1.3rem;
    }
    .stat-divider {
      height: 24px;
    }
    .hero-orb--orange {
      width: 300px;
      height: 300px;
    }
    .hero-orb--blue {
      width: 250px;
      height: 250px;
    }
  }

  @media (max-width: 380px) {
    .hero-stats {
      border-radius: var(--r-md);
    }
    .stat {
      padding: 0 8px;
    }
    .stat-num {
      font-size: 1.1rem;
    }
    .stat-label {
      font-size: 10px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-orb { animation: none; }
    .hero-eyebrow, .hero-title, .hero-subtitle,
    .hero-actions, .hero-stats {
      opacity: 1;
      animation: none;
    }
  }

  /* ── Services section ── */
  .services-section {
    padding: 72px 20px;
    background: var(--hc-gray-50);
  }
  .services-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .services-title {
    font-size: 2.5rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 40px;
    color: var(--hc-ink);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
