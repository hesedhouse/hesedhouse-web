---
import PageLayout from "../layouts/PageLayout.astro";
import LogoIntro from "../components/LogoIntro.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABanner from "../components/CTABanner.astro";

const services = [
  {
    eyebrow: "01",
    title: "IP LICENSE & COLLABO",
    description: "IP 라이선스 확보부터 브랜드 콜라보레이션까지, 최적의 파트너십을 설계합니다.",
    href: "/iplicensecollabo",
  },
  {
    eyebrow: "02",
    title: "MERCHANDISING",
    description: "트렌디한 굿즈와 MD 상품을 기획, 디자인, 생산합니다.",
    href: "/merchandising",
  },
  {
    eyebrow: "03",
    title: "DISTRIBUTION",
    description: "온·오프라인 유통 채널을 통해 글로벌 마켓에 진출합니다.",
    href: "/distribution",
  },
  {
    eyebrow: "04",
    title: "POP-UP OPERATION",
    description: "팝업스토어, 전시, 이벤트의 기획부터 운영까지 원스톱으로.",
    href: "/popupoperation",
  },
  {
    eyebrow: "05",
    title: "VISUAL STUDIO",
    description: "브랜드 아이덴티티를 완성하는 비주얼 콘텐츠를 제작합니다.",
    href: "/visualstudio",
  },
  {
    eyebrow: "06",
    title: "AI SOLUTION",
    description: "AI로 업무를 설계하고, 비즈니스를 자동화합니다. AI 여론 리서치 서비스 MindScope Korea를 운영합니다.",
    href: "/ai-solution",
    accent: true,
  },
  {
    eyebrow: "07",
    title: "INVESTMENT & BIZ DEV",
    description: "IP·콘텐츠·테크 분야의 성장 가능성을 발굴하고, 전략적 투자와 사업개발로 가치를 만듭니다.",
    href: "/investment",
    accent: true,
  },
];
---

<PageLayout
  title="HESEDCORP. | AI-Powered Business Partner"
  description="AI를 기반으로 IP 비즈니스, 콘텐츠, 커머스를 설계하는 기업, 헤세드코퍼레이션"
  transparentHeader
>
  <LogoIntro />

  <!-- ══════════════════════════════════════════
       INTERACTIVE HERO — Canvas particle network
       ══════════════════════════════════════════ -->
  <section class="hero-main" id="hero">
    <!-- Canvas for particle network -->
    <canvas class="hero-canvas" id="heroCanvas"></canvas>

    <!-- Mouse-following glow -->
    <div class="hero-glow" id="heroGlow"></div>

    <!-- Dark gradient base -->
    <div class="hero-bg"></div>

    <!-- Content -->
    <div class="hero-content">
      <p class="hero-eyebrow" data-animate="fade">HESEDCORP.</p>

      <h1 class="hero-title" data-animate="chars">
        <span class="hero-title-line">AI로 비즈니스를</span>
        <span class="hero-title-line"><span class="hero-accent">설계</span>합니다</span>
      </h1>

      <p class="hero-subtitle" data-animate="fade">
        IP 라이선스, 굿즈 제작, 유통, 팝업 운영, 커머스까지<br class="mobile-br" />
        10년의 현장 경험 위에 AI를 더합니다
      </p>

      <div class="hero-actions" data-animate="fade">
        <a class="hero-btn hero-btn--primary" href="/contact">
          <span class="btn-pulse"></span>
          프로젝트 문의
        </a>
        <a class="hero-btn hero-btn--ghost" href="/ai-solution">AI Solution →</a>
      </div>

      <!-- Stats bar with count-up -->
      <div class="hero-stats" data-animate="fade" id="heroStats">
        <div class="stat">
          <span class="stat-num"><span class="count-up" data-target="500">0</span><span class="stat-plus">+</span></span>
          <span class="stat-label">프로젝트</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num"><span class="count-up" data-target="50">0</span><span class="stat-plus">+</span></span>
          <span class="stat-label">파트너사</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num"><span class="count-up" data-target="10">0</span><span class="stat-plus">+</span></span>
          <span class="stat-label">AI 에이전트</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num"><span class="count-up" data-target="10">0</span><span class="stat-plus">yr</span></span>
          <span class="stat-label">Since 2016</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-hint" data-animate="fade">
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       INTERACTIVE ORBITAL — Service Ecosystem
       ══════════════════════════════════════════ -->
  <section class="orbital-section" id="orbitalSection">
    <div class="orbital-bg"></div>

    <div class="orbital-header">
      <p class="orbital-eyebrow">ECOSYSTEM</p>
      <h2 class="orbital-title">비즈니스의 모든 궤도</h2>
      <p class="orbital-desc">IP 라이선스부터 AI 솔루션까지, 7개 서비스가 하나의 생태계로 연결됩니다</p>
    </div>

    <div class="orbital-stage" id="orbitalStage">
      <!-- SVG orbit rings -->
      <svg class="orbit-svg" viewBox="0 0 700 700" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="hubGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#f39800" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#f39800" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <!-- Outer ring -->
        <circle cx="350" cy="350" r="310" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="4 6"/>
        <!-- Inner ring -->
        <circle cx="350" cy="350" r="190" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="4 6"/>
        <!-- Hub glow -->
        <circle cx="350" cy="350" r="120" fill="url(#hubGlow)"/>
        <!-- Connection lines (drawn by JS) -->
        <g id="orbitConnections"></g>
      </svg>

      <!-- Central hub -->
      <div class="orbital-hub" id="orbitalHub">
        <div class="hub-pulse"></div>
        <div class="hub-inner">
          <span class="hub-logo">HESED</span>
          <span class="hub-sub">CORP.</span>
        </div>
      </div>

      <!-- Orbit nodes — inner ring (3) -->
      <div class="orbit-ring-group" id="innerRing" data-radius="190" data-speed="0.0003">
        <a href="/iplicensecollabo" class="orbital-node" data-index="0" data-color="#f39800">
          <div class="node-dot"></div>
          <span class="node-label">IP LICENSE</span>
          <div class="node-card">
            <span class="node-num">01</span>
            <span class="node-title">IP LICENSE & COLLABO</span>
            <span class="node-desc">IP 라이선스 확보부터 브랜드 콜라보레이션까지</span>
          </div>
        </a>
        <a href="/merchandising" class="orbital-node" data-index="1" data-color="#64c8ff">
          <div class="node-dot"></div>
          <span class="node-label">MERCH</span>
          <div class="node-card">
            <span class="node-num">02</span>
            <span class="node-title">MERCHANDISING</span>
            <span class="node-desc">트렌디한 굿즈와 MD 상품을 기획·디자인·생산</span>
          </div>
        </a>
        <a href="/distribution" class="orbital-node" data-index="2" data-color="#a78bfa">
          <div class="node-dot"></div>
          <span class="node-label">DISTRIBUTION</span>
          <div class="node-card">
            <span class="node-num">03</span>
            <span class="node-title">DISTRIBUTION</span>
            <span class="node-desc">온·오프라인 유통 채널로 글로벌 마켓 진출</span>
          </div>
        </a>
      </div>

      <!-- Orbit nodes — outer ring (4) -->
      <div class="orbit-ring-group" id="outerRing" data-radius="310" data-speed="-0.00018">
        <a href="/popupoperation" class="orbital-node" data-index="0" data-color="#34d399">
          <div class="node-dot"></div>
          <span class="node-label">POP-UP</span>
          <div class="node-card">
            <span class="node-num">04</span>
            <span class="node-title">POP-UP OPERATION</span>
            <span class="node-desc">팝업스토어·전시·이벤트 기획부터 운영까지</span>
          </div>
        </a>
        <a href="/visualstudio" class="orbital-node" data-index="1" data-color="#f472b6">
          <div class="node-dot"></div>
          <span class="node-label">VISUAL</span>
          <div class="node-card">
            <span class="node-num">05</span>
            <span class="node-title">VISUAL STUDIO</span>
            <span class="node-desc">브랜드 아이덴티티를 완성하는 비주얼 콘텐츠</span>
          </div>
        </a>
        <a href="/ai-solution" class="orbital-node" data-index="2" data-color="#f39800">
          <div class="node-dot"></div>
          <span class="node-label">AI</span>
          <div class="node-card">
            <span class="node-num">06</span>
            <span class="node-title">AI SOLUTION</span>
            <span class="node-desc">AI로 업무를 설계하고 비즈니스를 자동화</span>
          </div>
        </a>
        <a href="/investment" class="orbital-node" data-index="3" data-color="#fbbf24">
          <div class="node-dot"></div>
          <span class="node-label">INVEST</span>
          <div class="node-card">
            <span class="node-num">07</span>
            <span class="node-title">INVESTMENT & BIZ DEV</span>
            <span class="node-desc">IP·콘텐츠·테크 분야의 전략적 투자와 사업개발</span>
          </div>
        </a>
      </div>

      <!-- Drag hint -->
      <div class="orbital-hint" id="orbitalHint">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2v4m0 12v4M2 12h4m12 0h4M6.34 6.34l2.83 2.83m5.66 5.66l2.83 2.83M17.66 6.34l-2.83 2.83m-5.66 5.66l-2.83 2.83"/>
        </svg>
        <span>드래그하여 회전</span>
      </div>
    </div>

    <!-- Mobile fallback list -->
    <div class="orbital-mobile-list">
      {services.map((s, i) => (
        <a href={s.href} class="orbital-mobile-item">
          <span class="mobile-item-num">{s.eyebrow}</span>
          <div class="mobile-item-text">
            <span class="mobile-item-title">{s.title}</span>
            <span class="mobile-item-desc">{s.description}</span>
          </div>
          <span class="mobile-item-arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="services-section">
    <div class="services-inner">
      <h2 class="services-title">Services</h2>
      <div class="services-grid">
        {services.map((s) => (
          <ServiceCard
            eyebrow={s.eyebrow}
            title={s.title}
            description={s.description}
            href={s.href}
            accent={s.accent ?? false}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    title="프로젝트를 함께 시작하세요"
    subtitle="IP 비즈니스의 A to Z, 헤세드코퍼레이션이 함께합니다."
    buttonText="CONTACT US"
    buttonHref="/contact"
  />
</PageLayout>

<!-- ═══════════════════════════════════════════
     INTERACTIVE SCRIPTS
     ═══════════════════════════════════════════ -->
<script>
  // ── 1. Particle Network Canvas ──
  (function initParticles() {
    const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = 0, h = 0;
    let mouse = { x: -9999, y: -9999 };
    let particles: Particle[] = [];
    let raf: number;

    const ORANGE = { r: 243, g: 152, b: 0 };
    const CYAN   = { r: 100, g: 200, b: 255 };
    const WHITE  = { r: 255, g: 255, b: 255 };

    const COLORS = [ORANGE, CYAN, WHITE, WHITE, WHITE];
    const CONNECT_DIST = 140;
    const MOUSE_RADIUS = 200;
    const PARTICLE_COUNT_FACTOR = 0.00008; // particles per px²

    interface Particle {
      x: number; y: number;
      vx: number; vy: number;
      r: number;
      color: typeof ORANGE;
      baseAlpha: number;
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.offsetWidth;
      h = canvas.offsetHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      initParticleArray();
    }

    function initParticleArray() {
      const count = Math.min(Math.floor(w * h * PARTICLE_COUNT_FACTOR), 160);
      particles = [];
      for (let i = 0; i < count; i++) {
        const color = COLORS[Math.floor(Math.random() * COLORS.length)];
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          r: Math.random() * 1.5 + 0.5,
          color,
          baseAlpha: color === WHITE ? 0.15 + Math.random() * 0.15 : 0.3 + Math.random() * 0.3,
        });
      }
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);

      // Update & draw particles
      for (const p of particles) {
        // Mouse repulsion / attraction
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < MOUSE_RADIUS) {
          const force = (1 - dist / MOUSE_RADIUS) * 0.02;
          p.vx += dx * force;
          p.vy += dy * force;
        }

        // Damping
        p.vx *= 0.98;
        p.vy *= 0.98;

        p.x += p.vx;
        p.y += p.vy;

        // Wrap
        if (p.x < -10) p.x = w + 10;
        if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10;
        if (p.y > h + 10) p.y = -10;

        // Draw particle
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${p.color.r},${p.color.g},${p.color.b},${p.baseAlpha})`;
        ctx!.fill();
      }

      // Draw connections
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const a = particles[i], b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < CONNECT_DIST) {
            const alpha = (1 - dist / CONNECT_DIST) * 0.12;
            // Use the color of the brighter particle for lines
            const c = a.color === WHITE ? b.color : a.color;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.strokeStyle = `rgba(${c.r},${c.g},${c.b},${alpha})`;
            ctx!.lineWidth = 0.6;
            ctx!.stroke();
          }
        }
      }

      raf = requestAnimationFrame(draw);
    }

    // Mouse tracking
    const hero = document.getElementById('hero')!;
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;

      // Move glow
      const glow = document.getElementById('heroGlow');
      if (glow) {
        glow.style.left = `${mouse.x}px`;
        glow.style.top = `${mouse.y}px`;
        glow.style.opacity = '1';
      }
    });
    hero.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
      const glow = document.getElementById('heroGlow');
      if (glow) glow.style.opacity = '0';
    });

    // Touch support
    hero.addEventListener('touchmove', (e) => {
      const rect = hero.getBoundingClientRect();
      const touch = e.touches[0];
      mouse.x = touch.clientX - rect.left;
      mouse.y = touch.clientY - rect.top;
    }, { passive: true });
    hero.addEventListener('touchend', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    window.addEventListener('resize', resize);
    resize();
    draw();

    // Cleanup on navigation
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
    });
  })();

  // ── 2. Text char-split animation ──
  (function initCharAnimations() {
    const titleEl = document.querySelector('[data-animate="chars"]') as HTMLElement;
    if (!titleEl) return;

    const lines = titleEl.querySelectorAll('.hero-title-line');
    let charIndex = 0;

    lines.forEach((line) => {
      const walker = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      let node: Text | null;
      while ((node = walker.nextNode() as Text | null)) {
        textNodes.push(node);
      }

      textNodes.forEach((textNode) => {
        const text = textNode.textContent || '';
        const frag = document.createDocumentFragment();
        for (const char of text) {
          const span = document.createElement('span');
          span.className = 'char';
          span.textContent = char === ' ' ? '\u00a0' : char;
          span.style.setProperty('--ci', String(charIndex));
          charIndex++;
          frag.appendChild(span);
        }
        textNode.parentNode!.replaceChild(frag, textNode);
      });
    });

    // Trigger animation
    requestAnimationFrame(() => {
      titleEl.classList.add('chars-ready');
    });
  })();

  // ── 3. Fade-in animations with stagger ──
  (function initFadeAnimations() {
    const elements = document.querySelectorAll('[data-animate="fade"]');
    let delay = 0.6; // Start after title animation
    elements.forEach((el) => {
      const htmlEl = el as HTMLElement;
      htmlEl.style.opacity = '0';
      htmlEl.style.transform = 'translateY(28px)';
      setTimeout(() => {
        htmlEl.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
        htmlEl.style.opacity = '1';
        htmlEl.style.transform = 'translateY(0)';
      }, delay * 1000);
      delay += 0.18;
    });
  })();

  // ── 4. Interactive Orbital ──
  (function initOrbital() {
    const stage = document.getElementById('orbitalStage');
    if (!stage) return;

    const innerRing = document.getElementById('innerRing');
    const outerRing = document.getElementById('outerRing');
    const connectionsGroup = document.getElementById('orbitConnections');
    const hint = document.getElementById('orbitalHint');
    if (!innerRing || !outerRing) return;

    const rings = [
      { el: innerRing, angle: 0, speed: 0.0003, radius: 190 },
      { el: outerRing, angle: Math.PI * 0.3, speed: -0.00018, radius: 310 },
    ];

    let isDragging = false;
    let dragStartAngle = 0;
    let dragStartMouse = 0;
    let activeRingIdx = -1;
    let hoveredNode: HTMLElement | null = null;
    let paused = false;
    let raf: number;
    let lastTime = 0;
    let hintHidden = false;

    const CENTER = 350; // SVG viewbox center

    function positionNodes(ring: typeof rings[0], time: number) {
      const nodes = ring.el.querySelectorAll('.orbital-node');
      const count = nodes.length;
      const angleStep = (Math.PI * 2) / count;

      nodes.forEach((node, i) => {
        const el = node as HTMLElement;
        const angle = ring.angle + i * angleStep;
        const x = Math.cos(angle) * ring.radius;
        const y = Math.sin(angle) * ring.radius;

        el.style.transform = `translate(${x}px, ${y}px)`;
        el.dataset.currentAngle = String(angle);

        // Draw connection line
        if (connectionsGroup) {
          const lineId = `conn-${ring.el.id}-${i}`;
          let line = connectionsGroup.querySelector(`#${lineId}`) as SVGLineElement | null;
          if (!line) {
            line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.id = lineId;
            line.setAttribute('stroke-width', '0.5');
            connectionsGroup.appendChild(line);
          }
          const nx = CENTER + x;
          const ny = CENTER + y;
          line.setAttribute('x1', String(CENTER));
          line.setAttribute('y1', String(CENTER));
          line.setAttribute('x2', String(nx));
          line.setAttribute('y2', String(ny));

          const isHovered = el === hoveredNode;
          const color = el.dataset.color || '#f39800';
          line.setAttribute('stroke', isHovered ? color : 'rgba(255,255,255,0.04)');
          line.style.transition = 'stroke 0.4s ease';
        }
      });
    }

    function animate(time: number) {
      if (!lastTime) lastTime = time;
      const dt = time - lastTime;
      lastTime = time;

      if (!paused && !isDragging) {
        rings.forEach(ring => {
          ring.angle += ring.speed * dt;
        });
      }

      rings.forEach(ring => positionNodes(ring, time));
      raf = requestAnimationFrame(animate);
    }

    // Drag to rotate
    stage.addEventListener('mousedown', (e) => {
      if ((e.target as HTMLElement).closest('.orbital-node')) return;
      isDragging = true;
      dragStartMouse = Math.atan2(
        e.clientY - stage.getBoundingClientRect().top - stage.offsetHeight / 2,
        e.clientX - stage.getBoundingClientRect().left - stage.offsetWidth / 2
      );
      // Rotate both rings together
      activeRingIdx = -1;
      rings.forEach((r, i) => { (r as any)._dragStart = r.angle; });
      stage.style.cursor = 'grabbing';

      if (!hintHidden && hint) {
        hint.style.opacity = '0';
        hintHidden = true;
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const rect = stage.getBoundingClientRect();
      const currentAngle = Math.atan2(
        e.clientY - rect.top - stage.offsetHeight / 2,
        e.clientX - rect.left - stage.offsetWidth / 2
      );
      const delta = currentAngle - dragStartMouse;
      rings.forEach(r => {
        r.angle = (r as any)._dragStart + delta * (r.speed > 0 ? 1 : -1);
      });
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        stage.style.cursor = '';
      }
    });

    // Touch drag
    let touchStartAngle = 0;
    stage.addEventListener('touchstart', (e) => {
      if ((e.target as HTMLElement).closest('.orbital-node')) return;
      const touch = e.touches[0];
      const rect = stage.getBoundingClientRect();
      touchStartAngle = Math.atan2(
        touch.clientY - rect.top - stage.offsetHeight / 2,
        touch.clientX - rect.left - stage.offsetWidth / 2
      );
      rings.forEach(r => { (r as any)._dragStart = r.angle; });
      isDragging = true;
      if (!hintHidden && hint) { hint.style.opacity = '0'; hintHidden = true; }
    }, { passive: true });

    stage.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const touch = e.touches[0];
      const rect = stage.getBoundingClientRect();
      const currentAngle = Math.atan2(
        touch.clientY - rect.top - stage.offsetHeight / 2,
        touch.clientX - rect.left - stage.offsetWidth / 2
      );
      const delta = currentAngle - touchStartAngle;
      rings.forEach(r => {
        r.angle = (r as any)._dragStart + delta * (r.speed > 0 ? 1 : -1);
      });
    }, { passive: true });

    stage.addEventListener('touchend', () => { isDragging = false; });

    // Hover effects on nodes
    const allNodes = stage.querySelectorAll('.orbital-node');
    allNodes.forEach((node) => {
      const el = node as HTMLElement;
      el.addEventListener('mouseenter', () => {
        paused = true;
        hoveredNode = el;
        el.classList.add('is-active');
        // Dim other nodes
        allNodes.forEach(n => {
          if (n !== el) (n as HTMLElement).classList.add('is-dimmed');
        });
      });
      el.addEventListener('mouseleave', () => {
        paused = false;
        hoveredNode = null;
        el.classList.remove('is-active');
        allNodes.forEach(n => (n as HTMLElement).classList.remove('is-dimmed'));
      });
    });

    // Scroll-triggered entry animation
    const section = document.getElementById('orbitalSection');
    if (section) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            section.classList.add('orbital-visible');
            observer.disconnect();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(section);
    }

    // Start
    raf = requestAnimationFrame(animate);

    // Cleanup
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
    });
  })();

  // ── 5. Count-up numbers ──
  (function initCountUp() {
    const counters = document.querySelectorAll('.count-up');
    let started = false;

    function animateCounters() {
      if (started) return;
      started = true;

      counters.forEach((el) => {
        const target = parseInt(el.getAttribute('data-target') || '0');
        const duration = 1800;
        const startTime = performance.now();

        function update(now: number) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.floor(target * eased));
          if (progress < 1) requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
      });
    }

    // Start count-up after hero animations complete
    setTimeout(animateCounters, 1400);
  })();
</script>

