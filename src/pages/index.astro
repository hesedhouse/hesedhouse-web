---
import PageLayout from "../layouts/PageLayout.astro";
import LogoIntro from "../components/LogoIntro.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABanner from "../components/CTABanner.astro";

const services = [
  {
    eyebrow: "01",
    title: "IP LICENSE & COLLABO",
    description: "IP 라이선스 확보부터 브랜드 콜라보레이션까지, 최적의 파트너십을 설계합니다.",
    href: "/iplicensecollabo",
  },
  {
    eyebrow: "02",
    title: "MERCHANDISING",
    description: "트렌디한 굿즈와 MD 상품을 기획, 디자인, 생산합니다.",
    href: "/merchandising",
  },
  {
    eyebrow: "03",
    title: "DISTRIBUTION",
    description: "온·오프라인 유통 채널을 통해 글로벌 마켓에 진출합니다.",
    href: "/distribution",
  },
  {
    eyebrow: "04",
    title: "POP-UP OPERATION",
    description: "팝업스토어, 전시, 이벤트의 기획부터 운영까지 원스톱으로.",
    href: "/popupoperation",
  },
  {
    eyebrow: "05",
    title: "VISUAL STUDIO",
    description: "브랜드 아이덴티티를 완성하는 비주얼 콘텐츠를 제작합니다.",
    href: "/visualstudio",
  },
  {
    eyebrow: "06",
    title: "AI SOLUTION",
    description: "AI로 업무를 설계하고, 비즈니스를 자동화합니다. AI 여론 리서치 서비스 MindScope Korea를 운영합니다.",
    href: "/ai-solution",
    accent: true,
  },
  {
    eyebrow: "07",
    title: "INVESTMENT & BIZ DEV",
    description: "IP·콘텐츠·테크 분야의 성장 가능성을 발굴하고, 전략적 투자와 사업개발로 가치를 만듭니다.",
    href: "/investment",
    accent: true,
  },
];
---

<PageLayout
  title="HESEDCORP. | AI-Powered IP Business Partner"
  description="AI와 IP 비즈니스를 결합하여 콘텐츠의 가치를 극대화하는 기업, 헤세드코퍼레이션"
  transparentHeader
>
  <LogoIntro />

  <!-- ══════════════════════════════════════════
       INTERACTIVE HERO — Canvas particle network
       ══════════════════════════════════════════ -->
  <section class="hero-main" id="hero">
    <!-- Canvas for particle network -->
    <canvas class="hero-canvas" id="heroCanvas"></canvas>

    <!-- Mouse-following glow -->
    <div class="hero-glow" id="heroGlow"></div>

    <!-- Dark gradient base -->
    <div class="hero-bg"></div>

    <!-- Content -->
    <div class="hero-content">
      <p class="hero-eyebrow" data-animate="fade">HESEDCORP.</p>

      <h1 class="hero-title" data-animate="chars">
        <span class="hero-title-line">IP 비즈니스를</span>
        <span class="hero-title-line">AI로 <span class="hero-accent">설계</span>합니다</span>
      </h1>

      <p class="hero-subtitle" data-animate="fade">
        라이선스부터 굿즈 제작, 유통, 팝업 운영까지<br class="mobile-br" />
        AI가 함께하는 IP 비즈니스 풀체인
      </p>

      <div class="hero-actions" data-animate="fade">
        <a class="hero-btn hero-btn--primary" href="/contact">
          <span class="btn-pulse"></span>
          프로젝트 문의
        </a>
        <a class="hero-btn hero-btn--ghost" href="/ai-solution">AI Solution →</a>
      </div>

      <!-- Stats bar with count-up -->
      <div class="hero-stats" data-animate="fade" id="heroStats">
        <div class="stat">
          <span class="stat-num"><span class="count-up" data-target="500">0</span><span class="stat-plus">+</span></span>
          <span class="stat-label">프로젝트</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num"><span class="count-up" data-target="50">0</span><span class="stat-plus">+</span></span>
          <span class="stat-label">파트너사</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num"><span class="count-up" data-target="10">0</span><span class="stat-plus">+</span></span>
          <span class="stat-label">AI 에이전트</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num"><span class="count-up" data-target="3">0</span><span class="stat-plus">yr</span></span>
          <span class="stat-label">IP 비즈니스</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-hint" data-animate="fade">
      <div class="scroll-line"></div>
    </div>
  </section>

  <section class="services-section">
    <div class="services-inner">
      <h2 class="services-title">Services</h2>
      <div class="services-grid">
        {services.map((s) => (
          <ServiceCard
            eyebrow={s.eyebrow}
            title={s.title}
            description={s.description}
            href={s.href}
            accent={s.accent ?? false}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    title="프로젝트를 함께 시작하세요"
    subtitle="IP 비즈니스의 A to Z, 헤세드코퍼레이션이 함께합니다."
    buttonText="CONTACT US"
    buttonHref="/contact"
  />
</PageLayout>

<!-- ═══════════════════════════════════════════
     INTERACTIVE SCRIPTS
     ═══════════════════════════════════════════ -->
<script>
  // ── 1. Particle Network Canvas ──
  (function initParticles() {
    const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = 0, h = 0;
    let mouse = { x: -9999, y: -9999 };
    let particles: Particle[] = [];
    let raf: number;

    const ORANGE = { r: 243, g: 152, b: 0 };
    const CYAN   = { r: 100, g: 200, b: 255 };
    const WHITE  = { r: 255, g: 255, b: 255 };

    const COLORS = [ORANGE, CYAN, WHITE, WHITE, WHITE];
    const CONNECT_DIST = 140;
    const MOUSE_RADIUS = 200;
    const PARTICLE_COUNT_FACTOR = 0.00008; // particles per px²

    interface Particle {
      x: number; y: number;
      vx: number; vy: number;
      r: number;
      color: typeof ORANGE;
      baseAlpha: number;
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.offsetWidth;
      h = canvas.offsetHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      initParticleArray();
    }

    function initParticleArray() {
      const count = Math.min(Math.floor(w * h * PARTICLE_COUNT_FACTOR), 160);
      particles = [];
      for (let i = 0; i < count; i++) {
        const color = COLORS[Math.floor(Math.random() * COLORS.length)];
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          r: Math.random() * 1.5 + 0.5,
          color,
          baseAlpha: color === WHITE ? 0.15 + Math.random() * 0.15 : 0.3 + Math.random() * 0.3,
        });
      }
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);

      // Update & draw particles
      for (const p of particles) {
        // Mouse repulsion / attraction
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < MOUSE_RADIUS) {
          const force = (1 - dist / MOUSE_RADIUS) * 0.02;
          p.vx += dx * force;
          p.vy += dy * force;
        }

        // Damping
        p.vx *= 0.98;
        p.vy *= 0.98;

        p.x += p.vx;
        p.y += p.vy;

        // Wrap
        if (p.x < -10) p.x = w + 10;
        if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10;
        if (p.y > h + 10) p.y = -10;

        // Draw particle
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${p.color.r},${p.color.g},${p.color.b},${p.baseAlpha})`;
        ctx!.fill();
      }

      // Draw connections
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const a = particles[i], b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < CONNECT_DIST) {
            const alpha = (1 - dist / CONNECT_DIST) * 0.12;
            // Use the color of the brighter particle for lines
            const c = a.color === WHITE ? b.color : a.color;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.strokeStyle = `rgba(${c.r},${c.g},${c.b},${alpha})`;
            ctx!.lineWidth = 0.6;
            ctx!.stroke();
          }
        }
      }

      raf = requestAnimationFrame(draw);
    }

    // Mouse tracking
    const hero = document.getElementById('hero')!;
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;

      // Move glow
      const glow = document.getElementById('heroGlow');
      if (glow) {
        glow.style.left = `${mouse.x}px`;
        glow.style.top = `${mouse.y}px`;
        glow.style.opacity = '1';
      }
    });
    hero.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
      const glow = document.getElementById('heroGlow');
      if (glow) glow.style.opacity = '0';
    });

    // Touch support
    hero.addEventListener('touchmove', (e) => {
      const rect = hero.getBoundingClientRect();
      const touch = e.touches[0];
      mouse.x = touch.clientX - rect.left;
      mouse.y = touch.clientY - rect.top;
    }, { passive: true });
    hero.addEventListener('touchend', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    window.addEventListener('resize', resize);
    resize();
    draw();

    // Cleanup on navigation
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
    });
  })();

  // ── 2. Text char-split animation ──
  (function initCharAnimations() {
    const titleEl = document.querySelector('[data-animate="chars"]') as HTMLElement;
    if (!titleEl) return;

    const lines = titleEl.querySelectorAll('.hero-title-line');
    let charIndex = 0;

    lines.forEach((line) => {
      const walker = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      let node: Text | null;
      while ((node = walker.nextNode() as Text | null)) {
        textNodes.push(node);
      }

      textNodes.forEach((textNode) => {
        const text = textNode.textContent || '';
        const frag = document.createDocumentFragment();
        for (const char of text) {
          const span = document.createElement('span');
          span.className = 'char';
          span.textContent = char === ' ' ? '\u00a0' : char;
          span.style.setProperty('--ci', String(charIndex));
          charIndex++;
          frag.appendChild(span);
        }
        textNode.parentNode!.replaceChild(frag, textNode);
      });
    });

    // Trigger animation
    requestAnimationFrame(() => {
      titleEl.classList.add('chars-ready');
    });
  })();

  // ── 3. Fade-in animations with stagger ──
  (function initFadeAnimations() {
    const elements = document.querySelectorAll('[data-animate="fade"]');
    let delay = 0.6; // Start after title animation
    elements.forEach((el) => {
      const htmlEl = el as HTMLElement;
      htmlEl.style.opacity = '0';
      htmlEl.style.transform = 'translateY(28px)';
      setTimeout(() => {
        htmlEl.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
        htmlEl.style.opacity = '1';
        htmlEl.style.transform = 'translateY(0)';
      }, delay * 1000);
      delay += 0.18;
    });
  })();

  // ── 4. Count-up numbers ──
  (function initCountUp() {
    const counters = document.querySelectorAll('.count-up');
    let started = false;

    function animateCounters() {
      if (started) return;
      started = true;

      counters.forEach((el) => {
        const target = parseInt(el.getAttribute('data-target') || '0');
        const duration = 1800;
        const startTime = performance.now();

        function update(now: number) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.floor(target * eased));
          if (progress < 1) requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
      });
    }

    // Start count-up after hero animations complete
    setTimeout(animateCounters, 1400);
  })();
</script>

<style>
  /* ============================================
     INTERACTIVE HERO
     ============================================ */
  .hero-main {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0 20px;
    cursor: crosshair;
  }

  /* ── Canvas ── */
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* ── Mouse-following glow ── */
  .hero-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(243, 152, 0, 0.10) 0%, transparent 65%);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.4s ease;
    filter: blur(30px);
  }

  /* ── Dark gradient base ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 45%, #0a1628 0%, transparent 70%),
      linear-gradient(180deg, #000810 0%, #001020 35%, #001a33 60%, #000a14 100%);
  }

  /* ── Content ── */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    text-align: center;
  }

  /* ── Eyebrow ── */
  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hc-orange);
    margin-bottom: 24px;
  }

  /* ── Title with char animation ── */
  .hero-title {
    font-family: var(--font-display);
    font-size: 3.8rem;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -1px;
    color: #fff;
    margin-bottom: 24px;
  }
  .hero-title-line {
    display: block;
  }

  /* Individual char animation */
  .hero-title :global(.char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px) rotateX(-40deg);
    filter: blur(6px);
    transition: none;
  }
  .hero-title.chars-ready :global(.char) {
    opacity: 1;
    transform: translateY(0) rotateX(0deg);
    filter: blur(0);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s ease;
    transition-delay: calc(0.3s + var(--ci) * 0.035s);
  }

  .hero-accent {
    color: var(--hc-orange);
    position: relative;
  }
  .hero-accent :global(.char) {
    color: var(--hc-orange);
  }
  .hero-accent::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--hc-orange);
    opacity: 0;
    border-radius: 2px;
    animation: accentLine 0.6s ease 1.2s forwards;
  }

  @keyframes accentLine {
    from { opacity: 0; transform: scaleX(0); }
    to   { opacity: 0.4; transform: scaleX(1); }
  }

  /* ── Subtitle ── */
  .hero-subtitle {
    font-family: var(--font-text);
    font-size: 1.15rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    max-width: 560px;
    margin: 0 auto 36px;
  }
  .mobile-br { display: none; }

  /* ── CTA buttons ── */
  .hero-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    margin-bottom: 56px;
  }
  .hero-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 32px;
    border-radius: var(--r-pill);
    transition: all 0.25s var(--ease-std);
    overflow: hidden;
  }
  .hero-btn--primary {
    background: var(--hc-orange);
    color: #fff;
  }
  .hero-btn--primary:hover {
    background: var(--hc-orange-deep);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 32px rgba(243, 152, 0, 0.35);
  }

  /* Pulse ring on primary CTA */
  .btn-pulse {
    position: absolute;
    inset: 0;
    border-radius: var(--r-pill);
    border: 2px solid var(--hc-orange);
    opacity: 0;
    animation: btnPulse 2.5s ease-in-out infinite 2s;
  }
  @keyframes btnPulse {
    0%   { opacity: 0.6; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.3); }
  }

  .hero-btn--ghost {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(8px);
  }
  .hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-2px);
  }

  /* ── Stats bar ── */
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--r-lg);
    padding: 20px 8px;
    backdrop-filter: blur(16px);
  }
  .stat {
    flex: 1;
    text-align: center;
    padding: 0 20px;
  }
  .stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }
  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
  }
  .stat-plus {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--hc-orange);
  }
  .stat-label {
    display: block;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.38);
    letter-spacing: 0.5px;
    margin-top: 4px;
  }

  /* ── Scroll indicator ── */
  .scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }
  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, rgba(255,255,255,0.3), transparent);
    animation: scrollBounce 2s ease-in-out infinite;
  }
  @keyframes scrollBounce {
    0%, 100% { opacity: 0.4; transform: translateY(0); }
    50%      { opacity: 1; transform: translateY(8px); }
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-main {
      min-height: 100svh;
      padding: 0 16px;
    }
    .hero-title {
      font-size: 2.4rem;
      letter-spacing: -0.5px;
    }
    .hero-subtitle {
      font-size: 1rem;
    }
    .mobile-br { display: inline; }
    .hero-actions {
      flex-direction: column;
      gap: 10px;
    }
    .hero-btn {
      width: 100%;
      justify-content: center;
    }
    .hero-stats {
      padding: 16px 6px;
    }
    .stat {
      padding: 0 10px;
    }
    .stat-num {
      font-size: 1.25rem;
    }
    .stat-divider {
      height: 24px;
    }
    .hero-glow {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .hero-stats {
      border-radius: var(--r-md);
    }
    .stat {
      padding: 0 6px;
    }
    .stat-num {
      font-size: 1.1rem;
    }
    .stat-label {
      font-size: 10px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-title :global(.char) {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .btn-pulse { animation: none; }
    .scroll-line { animation: none; opacity: 0.4; }
  }

  /* ── Services section ── */
  .services-section {
    padding: 72px 20px;
    background: var(--hc-gray-50);
  }
  .services-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .services-title {
    font-size: 2.5rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 40px;
    color: var(--hc-ink);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
