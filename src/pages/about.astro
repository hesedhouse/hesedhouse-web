---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/Hero.astro";
import CTABanner from "../components/CTABanner.astro";
import { clientBusiness, ownBusiness } from "../data/business";
import { homeStats, sinceYear } from "../data/home";

// 실적 수치는 홈과 같은 데이터(data/home.ts)를 쓴다 — 두 페이지 값이 어긋나지 않게
const stats = [
  ...homeStats.map((s) => ({ value: String(s.value), plus: true, label: s.short })),
  { value: String(sinceYear), plus: false, label: "Since" },
];
---

<PageLayout title="ABOUT" description="IP 비즈니스 솔루션, 상품 제작, 글로벌 유통 및 전시운영 전문 기업" theme="dark">
  <Hero
    dark
    dot
    eyebrow="About"
    title="HESEDCORP"
    subtitle="IP 비즈니스 솔루션, 상품 제작, 글로벌 유통 및 전시운영 전문 기업"
  />

  <section class="rdp-section">
    <div class="rdp-wrap rdp-split">
      <p class="rdp-eyebrow" data-rdp-reveal>Who we are</p>
      <div>
        <h2 class="rdp-h2" data-rdp-reveal>IP의 가치를 현실로,<br /><span class="dim">글로벌 문화 생태계를</span> 설계하다<span class="rdp-dot">.</span></h2>
        <p class="rdp-lead intro-body" data-rdp-reveal="2">
          헤세드코퍼레이션은 IP 라이선스, 상품 기획/제작, 글로벌 유통, 팝업스토어 운영까지
          IP 비즈니스의 전 과정을 아우르는 전문 기업입니다. 크리에이터와 브랜드의 IP를
          현실의 상품과 경험으로 전환하여, 팬과 소비자에게 새로운 가치를 전달합니다.
        </p>
      </div>
    </div>
  </section>

  <!-- 실적 수치 -->
  <section class="stats-section">
    <div class="rdp-wrap stats-inner">
      {stats.map((s, i) => (
        <div class="stat-item" data-rdp-reveal={String(i + 1)}>
          <span class="stat-value">{s.value}{s.plus && <sup>+</sup>}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 사업·브랜드: 데이터 src/data/business.ts -->
  <section class="rdp-section rdp-section--alt">
    <div class="rdp-wrap">
      <header class="rdp-head" data-rdp-reveal>
        <div>
          <p class="rdp-eyebrow">Business</p>
          <h2 class="rdp-h2">고객사의 프로젝트를 만들고,<br />자체 브랜드와 서비스를 운영합니다<span class="rdp-dot">.</span></h2>
        </div>
      </header>

      <div class="biz-group" data-rdp-reveal>
        <div class="biz-group-title">
          <h3>함께 만드는 일</h3>
          <p>CLIENT WORK</p>
        </div>
        <ol class="biz-list">
          {clientBusiness.map((b, i) => (
            <li>
              <a class="biz-row" href={b.href}>
                <span class="biz-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="biz-name">{b.name}</span>
                <span class="biz-desc">{b.desc}</span>
                <span class="biz-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <div class="biz-group" data-rdp-reveal>
        <div class="biz-group-title">
          <h3>직접 운영하는 브랜드와 서비스</h3>
          <p>OWN BRANDS &amp; SERVICES</p>
        </div>
        <ol class="biz-list">
          {ownBusiness.map((b, i) => {
            const inner = (
              <>
                <span class="biz-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="biz-name">{b.name}</span>
                <span class="biz-desc">{b.desc}</span>
                <span class="biz-tag">{b.tag}</span>
              </>
            );
            return (
              <li>
                {b.href
                  ? <a class="biz-row" href={b.href} target="_blank" rel="noopener">{inner}</a>
                  : <div class="biz-row">{inner}</div>}
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <CTABanner
    title="함께 만들어갈 다음 프로젝트가 있으신가요?"
    buttonText="CONTACT US"
    buttonHref="/contact"
  />
</PageLayout>

<style>
  .intro-body {
    margin-top: clamp(24px, 3vw, 40px);
    max-width: 760px;
  }

  /* ── 실적 수치: 선으로 나눈 4칸 ── */
  .stats-section {
    border-top: 1px solid var(--line);
  }

  .stats-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(32px, 4vw, 56px) clamp(16px, 2.4vw, 36px);
    border-left: 1px solid var(--line);
  }

  .stat-item:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stat-value {
    font-size: clamp(40px, 5.6vw, 84px);
    font-weight: 760;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--fg);
  }

  .stat-value sup {
    font-size: 0.42em;
    color: var(--accent);
    vertical-align: top;
    position: relative;
    top: 0.08em;
    margin-left: 2px;
  }

  .stat-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── 사업·브랜드 — 괘선 목록 ── */
  .biz-group {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 3.4fr;
    gap: clamp(24px, 4vw, 56px);
    padding-top: 28px;
    border-top: 1px solid var(--line2);
  }

  .biz-group + .biz-group {
    margin-top: clamp(48px, 6vw, 80px);
  }

  .biz-group-title h3 {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--fg);
  }

  .biz-group-title p {
    margin-top: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .biz-list li {
    border-bottom: 1px solid var(--line);
  }

  .biz-list li:first-child .biz-row {
    padding-top: 0;
  }

  .biz-row {
    display: grid;
    grid-template-columns: 40px minmax(160px, 1fr) 2.2fr auto;
    gap: 16px;
    align-items: baseline;
    padding: 20px 0;
    color: var(--fg);
  }

  .biz-num {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .biz-name {
    font-size: clamp(17px, 1.5vw, 21px);
    font-weight: 650;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }

  .biz-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg2);
  }

  .biz-go,
  .biz-tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--muted);
    white-space: nowrap;
  }

  .biz-go {
    font-size: 16px;
    transition: transform 0.3s var(--ease), color 0.3s;
  }

  a.biz-row:hover .biz-name {
    color: var(--accent);
  }

  a.biz-row:hover .biz-go {
    transform: translateX(6px);
    color: var(--accent);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-item {
      padding: 28px 16px;
    }

    .stat-item:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }

    .stat-item:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .biz-group {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .biz-row {
      grid-template-columns: 30px 1fr auto;
      gap: 4px 12px;
    }

    .biz-desc {
      grid-column: 2 / -1;
      grid-row: 2;
      font-size: 14px;
    }
  }
</style>
