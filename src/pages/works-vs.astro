---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import CTABanner from '../components/CTABanner.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
---
<PageLayout title="WORKS - VISUAL STUDIO" description="헤세드코퍼레이션의 비주얼 콘텐츠 제작 포트폴리오">
  <Hero dark={false} eyebrow="WORKS" title="VISUAL STUDIO" subtitle="비주얼 콘텐츠 제작 포트폴리오" />
  <section class="portfolio">
    <div class="portfolio-inner">
      <div class="portfolio-grid">
        <PortfolioCard
          category="vs"
          client="Client A"
          title="브랜드 비주얼 아이덴티티"
          year="2026"
        />
        <PortfolioCard
          category="vs"
          client="Client B"
          title="제품 촬영 및 콘텐츠 제작"
          year="2026"
        />
      </div>
      <p class="coming-soon">More projects coming soon.</p>
    </div>
  </section>
  <CTABanner title="프로젝트를 함께 만들어요" buttonText="CONTACT US" buttonHref="/contact" />
</PageLayout>
<style>
  .portfolio { padding: 72px 20px; }
  .portfolio-inner { max-width: var(--content-max); margin: 0 auto; }
  .portfolio-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .coming-soon { text-align: center; color: rgba(0,0,0,0.32); font-size: 14px; margin-top: 48px; }
  @media (max-width: 768px) { .portfolio-grid { grid-template-columns: 1fr; } }
</style>
