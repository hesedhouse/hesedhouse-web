---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABanner from '../../components/CTABanner.astro';

const stats = [
  { number: "500+", label: "누적 제작 프로젝트" },
  { number: "50~50,000", label: "유연한 제작 수량" },
  { number: "100%", label: "납기 준수율" },
  { number: "72%", label: "재주문율" },
];

const categories = [
  { icon: "🧸", title: "키링 · 액세서리", desc: "아크릴, 메탈, 러버, 우드 등 다양한 소재의 키링과 뱃지, 마그넷" },
  { icon: "👕", title: "의류 · 단체복", desc: "티셔츠, 후드, 맨투맨, 유니폼, 행사 스태프복" },
  { icon: "🖊️", title: "문구 · 스티커", desc: "노트, 다이어리, 볼펜, 스티커, 마스킹 테이프" },
  { icon: "☕", title: "텀블러 · 리빙", desc: "텀블러, 머그컵, 쿠션, 담요, 파우치" },
  { icon: "📦", title: "패키지 · 키트", desc: "웰컴키트, VIP기프트, 언박싱 패키지 풀구성" },
  { icon: "🖼️", title: "인쇄 · 디자인", desc: "포토카드, 엽서, 포스터, 아트프린트, 액자" },
  { icon: "💻", title: "디지털 · 테크", desc: "보조배터리, 마우스패드, 폰케이스, USB" },
  { icon: "🎁", title: "프리미엄 기프트", desc: "가죽 제품, 향초, 디퓨저, 프리미엄 세트" },
  { icon: "🌿", title: "에코 · 친환경", desc: "리사이클 소재, 친환경 패키징, 에코백" },
];

const process = [
  { step: "01", title: "상담 · 기획", desc: "목적, 예산, 수량, 일정을 파악하고 최적의 아이템과 구성을 제안합니다.", duration: "1~2일" },
  { step: "02", title: "디자인 · 시안", desc: "브랜드 가이드에 맞춘 디자인 시안을 제작하고, 3D 목업으로 사전 확인합니다.", duration: "3~5일" },
  { step: "03", title: "샘플 · 승인", desc: "실물 샘플을 제작하여 색감, 품질, 마감을 직접 확인합니다.", duration: "5~7일" },
  { step: "04", title: "본생산 · QC", desc: "승인된 샘플 기준으로 본생산을 진행하고, 전수 품질검수합니다.", duration: "7~14일" },
  { step: "05", title: "납품 · 배송", desc: "안전 포장 후 지정 장소로 납품합니다. 전국 배송, 해외 배송 가능.", duration: "1~3일" },
];

const useCases = [
  { eyebrow: "EVENT", title: "이벤트 · 캠페인", desc: "브랜드 팝업, 론칭 이벤트, 프로모션 사은품까지 목적에 맞는 굿즈를 기획합니다." },
  { eyebrow: "IP · CHARACTER", title: "IP · 캐릭터 상품", desc: "캐릭터 IP를 활용한 정식 라이선스 굿즈. 기획부터 라이선스 확보까지 원스톱." },
  { eyebrow: "CORPORATE", title: "기업 웰컴키트 · 기프트", desc: "신규 입사자 웰컴키트, 임직원 기프트, 고객 감사 패키지를 제작합니다." },
  { eyebrow: "POPUP", title: "팝업스토어 · 현장판매", desc: "팝업스토어에서 판매할 MD 라인업을 기획하고, 현장 운영까지 연계합니다." },
];
---

<PageLayout title="GOODS — 굿즈 기획·제작" description="아이디어만 주세요. 기획부터 납품까지, 원스톱으로." transparentHeader>
  <!-- Hero: Fullscreen -->
  <Hero
    dark
    fullscreen
    eyebrow="HESED GOODS STUDIO"
    title="아이디어를 굿즈로."
    subtitle="기획, 디자인, 샘플링, 생산, 납품까지 — 원스톱으로 만듭니다."
    accentWord="굿즈"
  />

  <!-- Stats Bar -->
  <section class="stats-bar">
    <div class="container stats-inner">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat-number">{s.number}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Intro -->
  <section class="intro">
    <div class="container intro-inner">
      <span class="section-badge">WHY HESED</span>
      <h2 class="section-title">그냥 만드는 게 아니라,<br />브랜드를 만듭니다.</h2>
      <p class="section-body">
        헤세드코퍼레이션은 IP 라이선스 전문 기업입니다.
        단순 제조가 아니라, 브랜드의 세계관을 이해하고
        IP 확보부터 상품 기획, 디자인, 생산, 유통, 팝업 운영까지
        굿즈 비즈니스의 전 과정을 함께합니다.
      </p>
    </div>
  </section>

  <!-- Differentiators -->
  <section class="diff-section">
    <div class="container diff-inner">
      <div class="diff-grid">
        <ServiceCard
          eyebrow="ONE-STOP"
          title="기획부터 납품까지"
          description="아이디어만 주세요. 디자인, 샘플, 생산, 패키징, 배송까지 전 과정을 전담합니다. 중간 업체 없이 한 번에."
          accent
        />
        <ServiceCard
          eyebrow="IP EXPERT"
          title="IP 라이선스 연계"
          description="라이선스 확보부터 로열티 정산까지. IP 전문 기업이기에 가능한, 기획과 법무가 결합된 원스톱 서비스."
          dark
        />
        <ServiceCard
          eyebrow="FLEXIBLE"
          title="50개부터 5만 개까지"
          description="소량 맞춤 제작부터 대량 양산까지. 수량에 맞는 최적의 공정과 단가를 제안합니다."
          dark
        />
        <ServiceCard
          eyebrow="POPUP READY"
          title="팝업 · 유통 연계"
          description="만들고 끝이 아닙니다. 팝업스토어 운영, 온라인 유통, B2B 납품까지 판매 채널을 함께 설계합니다."
          dark
        />
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="categories">
    <div class="container categories-inner">
      <span class="section-badge">CATEGORY</span>
      <h2 class="section-title">만들 수 있는 모든 것.</h2>
      <p class="section-sub">9개 카테고리, 200종 이상의 아이템을 제작합니다.</p>
      <div class="cat-grid">
        {categories.map((c) => (
          <div class="cat-card">
            <span class="cat-icon">{c.icon}</span>
            <h3 class="cat-title">{c.title}</h3>
            <p class="cat-desc">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process">
    <div class="container process-inner">
      <span class="section-badge">PROCESS</span>
      <h2 class="section-title dark-title">간단합니다.</h2>
      <p class="section-sub dark-sub">문의부터 납품까지, 평균 3~4주.</p>
      <div class="process-timeline">
        {process.map((p, i) => (
          <div class="process-step">
            <div class="step-marker">
              <span class="step-num">{p.step}</span>
              {i < process.length - 1 && <div class="step-line" />}
            </div>
            <div class="step-content">
              <h3 class="step-title">{p.title}</h3>
              <p class="step-desc">{p.desc}</p>
              <span class="step-duration">{p.duration}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="usecases">
    <div class="container usecases-inner">
      <span class="section-badge">USE CASE</span>
      <h2 class="section-title">어떤 굿즈가 필요하세요?</h2>
      <div class="usecase-grid">
        {useCases.map((u) => (
          <ServiceCard eyebrow={u.eyebrow} title={u.title} description={u.desc} />
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Quote CTA -->
  <section class="quote-section">
    <div class="container quote-inner">
      <div class="quote-content">
        <span class="section-badge">QUICK QUOTE</span>
        <h2 class="section-title">평균 4시간 내 견적 회신.</h2>
        <p class="quote-body">
          아이템, 수량, 디자인 소스만 알려주세요.<br />
          전담 매니저가 최적의 견적을 빠르게 보내드립니다.
        </p>
        <div class="quote-actions">
          <a class="btn-primary" href="/contact">견적 문의하기</a>
          <a class="btn-secondary" href="http://pf.kakao.com/_Kxnkxou" target="_blank" rel="noopener">카카오톡 상담</a>
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    title="굿즈, 고민만 하고 계신가요?"
    subtitle="아이디어만 있으면 충분합니다. 나머지는 헤세드가."
    buttonText="프로젝트 문의하기"
    buttonHref="/contact"
  />
</PageLayout>

<style>
  /* ── Stats Bar ── */
  .stats-bar {
    background: var(--hc-navy);
    padding: 40px 20px;
  }

  .stats-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }

  .stat-number {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--hc-orange);
    line-height: 1.2;
  }

  .stat-label {
    display: block;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 6px;
  }

  /* ── Intro ── */
  .intro {
    padding: 96px 20px 72px;
    text-align: center;
  }

  .intro-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--hc-orange);
    background: rgba(243, 152, 0, 0.08);
    padding: 6px 16px;
    border-radius: var(--r-pill);
    margin-bottom: 20px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--hc-ink);
    margin-bottom: 16px;
  }

  .section-sub {
    font-size: 1.1875rem;
    color: var(--fg-secondary, #6e6e73);
    line-height: 1.5;
  }

  .section-body {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--fg-secondary, #6e6e73);
  }

  /* ── Differentiators ── */
  .diff-section {
    padding: 0 20px 96px;
  }

  .diff-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .diff-grid > :first-child {
    grid-column: 1 / -1;
  }


  /* ── Categories ── */
  .categories {
    padding: 96px 20px;
    background: var(--hc-gray-50);
    text-align: center;
  }

  .categories-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
    text-align: left;
  }

  .cat-card {
    background: #fff;
    border-radius: 16px;
    padding: 32px 24px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .cat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .cat-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 16px;
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--hc-ink);
    margin-bottom: 8px;
  }

  .cat-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--fg-secondary, #6e6e73);
  }

  /* ── Process ── */
  .process {
    padding: 96px 20px;
    background: var(--hc-navy);
  }

  .process-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .dark-title {
    color: #fff;
  }

  .dark-sub {
    color: rgba(255, 255, 255, 0.65);
  }

  .process .section-badge {
    background: rgba(243, 152, 0, 0.15);
  }

  .process-timeline {
    margin-top: 56px;
    text-align: left;
  }

  .process-step {
    display: flex;
    gap: 28px;
    position: relative;
  }

  .step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 48px;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--hc-orange);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-line {
    width: 2px;
    flex: 1;
    background: rgba(255, 255, 255, 0.15);
    margin: 8px 0;
  }

  .step-content {
    padding-bottom: 40px;
  }

  .process-step:last-child .step-content {
    padding-bottom: 0;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 8px;
    padding-top: 10px;
  }

  .step-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
  }

  .step-duration {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--hc-orange);
    background: rgba(243, 152, 0, 0.15);
    padding: 3px 12px;
    border-radius: var(--r-pill);
  }

  /* ── Use Cases ── */
  .usecases {
    padding: 96px 20px;
    text-align: center;
  }

  .usecases-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .usecase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-top: 48px;
    text-align: left;
  }

  /* ── Quote CTA ── */
  .quote-section {
    padding: 96px 20px;
    background: var(--hc-gray-50);
  }

  .quote-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .quote-content {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .quote-body {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--fg-secondary, #6e6e73);
    margin-bottom: 36px;
  }

  .quote-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    background: var(--hc-orange);
    padding: 14px 36px;
    border-radius: var(--r-pill);
    transition: background 0.2s, transform 0.2s;
  }

  .btn-primary:hover {
    background: var(--hc-orange-deep);
    transform: scale(1.03);
  }

  .btn-secondary {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--hc-navy);
    background: #fff;
    border: 1.5px solid var(--hc-navy);
    padding: 13px 36px;
    border-radius: var(--r-pill);
    transition: background 0.2s, transform 0.2s;
  }

  .btn-secondary:hover {
    background: var(--hc-navy);
    color: #fff;
    transform: scale(1.03);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .stat-number {
      font-size: 1.5rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .diff-grid {
      grid-template-columns: 1fr;
    }

    .diff-grid > :first-child {
      grid-column: auto;
    }

    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .usecase-grid {
      grid-template-columns: 1fr;
    }

    .process-step {
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }

    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .quote-actions {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
