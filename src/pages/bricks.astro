---
// BRICKS Brand Development Hub — 비공개 페이지
// sitemap 제외, 네비게이션 미노출
// Updated: 2026-06-09 — 전체 프로젝트 허브 (새 컬러 #8B3A2A 반영)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>BRICKS — Brand Development Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Noto+Sans+KR:wght@300;400;500;700;900&family=JetBrains+Mono:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='2' y='8' width='28' height='16' rx='2' fill='%238B3A2A'/><text x='16' y='20' text-anchor='middle' fill='%23F5E6D3' font-family='serif' font-size='10' font-weight='bold'>B</text></svg>">
  <style>
:root{--bg:#0b0a09;--sf:#141210;--sf2:#1a1714;--sf3:#201c18;--brick:#8B3A2A;--bl:#A85040;--bd:#6B2A1E;--warm:#E8A87C;--sand:#F5E6D3;--gold:#C9A96E;--cel:#7BA298;--tx:#E8E4DF;--mu:#8A8279;--dim:#5A544D;--bdr:rgba(180,120,70,.10);--bdr-h:rgba(139,58,42,.22);--fd:'DM Serif Display',Georgia,serif;--fb:'Noto Sans KR',-apple-system,sans-serif;--fm:'JetBrains Mono',monospace;--fe:'Cormorant Garamond',Georgia,serif}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--fb);background:var(--bg);color:var(--tx);line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::after{content:'';position:fixed;inset:0;opacity:.014;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");pointer-events:none;z-index:9999}
::selection{background:rgba(139,58,42,.3);color:var(--sand)}
a{color:var(--tx);text-decoration:none;transition:color .3s}a:hover{color:var(--brick)}

/* NAV */
.top-nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(11,10,9,.95);backdrop-filter:blur(20px);border-bottom:1px solid var(--bdr);display:flex;align-items:center;height:56px;padding:0 32px;gap:24px}
.top-nav .logo{font-family:var(--fd);font-size:16px;color:var(--brick);letter-spacing:6px;margin-right:auto}
.top-nav .tabs{display:flex;gap:4px}
.top-nav .tab{font-family:var(--fm);font-size:9px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;padding:8px 16px;border-radius:2px;cursor:pointer;transition:all .3s;border:none;background:none}
.top-nav .tab:hover{color:var(--mu)}
.top-nav .tab.active{color:var(--brick);background:rgba(139,58,42,.08)}

/* SECTIONS */
.page{display:none;padding-top:56px;min-height:100vh}
.page.active{display:block}
.wrap{max-width:1200px;margin:0 auto;padding:0 48px}
.sr{opacity:0;transform:translateY(32px);transition:opacity .9s cubic-bezier(.23,1,.32,1),transform .9s cubic-bezier(.23,1,.32,1)}.sr.v{opacity:1;transform:none}
.d1{transition-delay:.1s}.d2{transition-delay:.2s}.d3{transition-delay:.3s}.d4{transition-delay:.4s}.d5{transition-delay:.5s}

/* COVER */
.cover{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:80px 40px;position:relative;overflow:hidden}
.cover-bg{position:absolute;inset:0;background:url('/bricks/hero.png') center/cover;opacity:.3}
.cover-overlay{position:absolute;inset:0;background:radial-gradient(circle at center,rgba(11,10,9,.5) 0%,rgba(11,10,9,.85) 100%)}
.cover *:not(.cover-bg):not(.cover-overlay){position:relative;z-index:1}
.cover-logo{max-width:400px;width:80%;margin-bottom:32px;filter:brightness(1.3);animation:fadeUp 1s ease .3s both}
.cover-tagline{font-family:var(--fe);font-size:clamp(16px,2.5vw,22px);color:var(--mu);font-style:italic;letter-spacing:6px;animation:fadeUp 1s ease .6s both}
.cover-kr{font-size:14px;color:var(--dim);letter-spacing:4px;font-weight:300;margin-top:6px;animation:fadeUp 1s ease .8s both}
.cover-meta{font-family:var(--fm);font-size:9px;letter-spacing:3px;color:var(--dim);margin-top:48px;animation:fadeUp 1s ease 1s both}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}

/* SECTION HEADERS */
.sec{padding:100px 0;border-top:1px solid var(--bdr)}
.sn{font-family:var(--fm);font-size:10px;letter-spacing:4px;color:var(--dim);text-transform:uppercase;margin-bottom:10px}
.st{font-family:var(--fd);font-size:clamp(24px,3.5vw,36px);color:var(--sand);letter-spacing:2px;margin-bottom:8px}
.sd{font-size:14px;color:var(--mu);max-width:520px;margin-bottom:48px;line-height:2}

/* STATS */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.stat{background:var(--sf);border:1px solid var(--bdr);border-radius:3px;padding:20px;text-align:center;transition:border-color .3s}
.stat:hover{border-color:var(--bdr-h)}
.stat .sv{font-family:var(--fd);font-size:24px;color:var(--brick);letter-spacing:1px;margin-bottom:4px}
.stat .sl{font-family:var(--fm);font-size:8px;letter-spacing:2px;color:var(--dim);text-transform:uppercase}
.stat.gold .sv{color:var(--gold)}.stat.cel .sv{color:var(--cel)}

/* BRAND CARDS */
.brand-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.brand-card{background:var(--sf);border:1px solid var(--bdr);border-radius:3px;padding:28px}
.brand-card h4{font-family:var(--fm);font-size:9px;letter-spacing:3px;color:var(--brick);text-transform:uppercase;margin-bottom:16px}
.brand-card p{font-size:13px;color:var(--mu);line-height:2}

/* PRODUCT GRID */
.products{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.product{background:var(--sf);border:1px solid var(--bdr);border-radius:3px;overflow:hidden;transition:all .4s}
.product:hover{border-color:var(--bdr-h);transform:translateY(-4px);box-shadow:0 16px 48px rgba(0,0,0,.3)}
.p-img{aspect-ratio:3/4;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center}
.p-img .bg{position:absolute;inset:0;transition:transform .6s cubic-bezier(.23,1,.32,1)}
.product:hover .bg{transform:scale(1.05)}
.p-img .tag{position:absolute;top:12px;left:12px;font-family:var(--fm);font-size:8px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;background:rgba(11,10,9,.6);padding:3px 8px;border-radius:2px;backdrop-filter:blur(6px)}
.p-info{padding:16px 20px;border-top:1px solid var(--bdr);display:flex;justify-content:space-between;align-items:flex-end}
.p-info .name{font-family:var(--fd);font-size:14px;color:var(--sand);letter-spacing:1px}
.p-info .price{font-family:var(--fm);font-size:11px;color:var(--mu)}

/* TIMELINE */
.timeline{position:relative;padding-left:120px}
.timeline::before{content:'';position:absolute;left:100px;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,var(--brick),var(--bdr),transparent)}
.tl-phase{position:relative;margin-bottom:56px}
.tl-phase::before{content:'';position:absolute;left:-24px;top:6px;width:8px;height:8px;background:var(--brick);border-radius:50%;box-shadow:0 0 12px rgba(139,58,42,.3)}
.tl-phase .tp-period{position:absolute;left:-120px;top:2px;width:80px;text-align:right;font-family:var(--fm);font-size:9px;letter-spacing:1px;color:var(--dim)}
.tl-phase .tp-name{font-family:var(--fd);font-size:20px;color:var(--sand);letter-spacing:2px;margin-bottom:4px}
.tl-phase .tp-sub{font-size:12px;color:var(--brick);margin-bottom:12px}
.tl-items{display:flex;flex-direction:column;gap:4px}
.tl-items .ti{font-size:12px;color:var(--mu);line-height:1.8;padding-left:14px;position:relative}
.tl-items .ti::before{content:'';position:absolute;left:0;top:8px;width:4px;height:4px;background:var(--dim);border-radius:50%}
.tl-items .ti.done{color:var(--cel)}.tl-items .ti.done::before{background:var(--cel)}

/* METRICS */
.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.metric{background:var(--sf);border:1px solid var(--bdr);border-radius:3px;padding:18px;text-align:center}
.metric .mv{font-family:var(--fd);font-size:22px;color:var(--brick);margin-bottom:2px}
.metric .ml{font-family:var(--fm);font-size:8px;letter-spacing:2px;color:var(--dim);text-transform:uppercase}

/* REVENUE BAR CHART */
.bar-chart{display:flex;align-items:flex-end;gap:6px;height:200px;padding:16px 0;border-bottom:1px solid var(--bdr);margin-bottom:12px}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;height:100%;justify-content:flex-end}
.bar-col .bar{width:100%;border-radius:2px 2px 0 0;transition:height 1.5s cubic-bezier(.23,1,.32,1)}
.bar-col .bv{font-family:var(--fm);font-size:8px;color:var(--mu)}
.bar-col .bl{font-family:var(--fm);font-size:8px;color:var(--dim);margin-top:6px}

/* DONUT */
.donut-wrap{display:flex;align-items:center;gap:40px;justify-content:center}
.donut{width:180px;height:180px;border-radius:50%;background:conic-gradient(var(--brick) 0deg 144deg,var(--gold) 144deg 252deg,var(--cel) 252deg 324deg,var(--warm) 324deg 360deg);display:flex;align-items:center;justify-content:center;position:relative}
.donut::after{content:'';position:absolute;width:110px;height:110px;border-radius:50%;background:var(--bg)}
.donut-center{position:relative;z-index:1;text-align:center}
.donut-legend{display:flex;flex-direction:column;gap:10px}
.donut-legend .dl{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--mu)}
.donut-legend .dd{width:8px;height:8px;border-radius:2px;flex-shrink:0}

/* SNS GRID PREVIEW */
.sns-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;max-width:480px;margin:0 auto;border-radius:4px;overflow:hidden}
.sns-cell{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;transition:transform .3s;position:relative;overflow:hidden}
.sns-cell:hover{z-index:2;transform:scale(1.05)}

/* IMAGES */
.img-full{width:100%;border-radius:4px;margin:24px 0}
.journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.journal-card{border-radius:3px;overflow:hidden;position:relative;transition:transform .4s}
.journal-card:hover{transform:translateY(-4px)}
.jc-img{aspect-ratio:3/4;overflow:hidden;position:relative}
.jc-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.23,1,.32,1)}
.journal-card:hover img{transform:scale(1.06)}
.jc-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(11,10,9,.85) 0%,rgba(11,10,9,.2) 50%,transparent 100%)}
.jc-content{position:absolute;bottom:0;left:0;right:0;padding:24px}
.jc-content .cat{font-family:var(--fm);font-size:9px;letter-spacing:2px;color:var(--brick);text-transform:uppercase;margin-bottom:8px}
.jc-content .title{font-family:var(--fd);font-size:18px;color:var(--sand);letter-spacing:1px;margin-bottom:6px}
.jc-content .date{font-family:var(--fm);font-size:9px;color:var(--dim)}

/* VALUES */
.val-item{display:grid;grid-template-columns:60px 140px 1fr;gap:24px;align-items:center;padding:28px 0;border-top:1px solid var(--bdr)}
.val-item:last-child{border-bottom:1px solid var(--bdr)}
.val-item .vn{font-family:var(--fd);font-size:32px;color:rgba(139,58,42,.12)}
.val-item .ve{font-family:var(--fd);font-size:18px;color:var(--sand);letter-spacing:3px}
.val-item .vd{font-size:13px;color:var(--mu);line-height:1.9}

/* NEWSLETTER */
.nl{max-width:500px;margin:0 auto;text-align:center}
.nl h3{font-family:var(--fd);font-size:clamp(24px,3vw,32px);color:var(--sand);letter-spacing:2px;margin-bottom:8px}
.nl p{font-size:13px;color:var(--mu);margin-bottom:28px}
.nl-form{display:flex;gap:0}
.nl-form input{flex:1;padding:14px 16px;background:var(--sf);border:1px solid var(--bdr);border-right:none;border-radius:2px 0 0 2px;color:var(--tx);font-family:var(--fb);font-size:13px;outline:none}
.nl-form input:focus{border-color:var(--brick)}
.nl-form input::placeholder{color:var(--dim)}
.nl-form button{padding:14px 24px;background:var(--brick);border:1px solid var(--brick);border-radius:0 2px 2px 0;color:var(--sand);font-family:var(--fm);font-size:9px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:background .3s}
.nl-form button:hover{background:var(--bd)}

/* TABLE */
.dtable{width:100%;border-collapse:collapse}
.dtable th{font-family:var(--fm);font-size:9px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;text-align:left;padding:10px 14px;border-bottom:1px solid var(--bdr);background:var(--sf)}
.dtable td{padding:10px 14px;font-size:12px;color:var(--mu);border-bottom:1px solid rgba(180,120,70,.05)}
.dtable td:first-child{color:var(--sand)}
.mono{font-family:var(--fm);font-size:11px;letter-spacing:.5px}
.hl{color:var(--brick);font-weight:500}

/* FOOTER */
.pg-footer{text-align:center;padding:60px 48px;border-top:1px solid var(--bdr)}

/* RESPONSIVE */
@media(max-width:1024px){.stats{grid-template-columns:repeat(2,1fr)}.products{grid-template-columns:repeat(2,1fr)}.metrics{grid-template-columns:repeat(3,1fr)}.brand-grid{grid-template-columns:1fr}.journal-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:768px){.wrap{padding:0 24px}.top-nav{padding:0 16px;gap:12px;overflow-x:auto}.top-nav .tab{padding:8px 10px;font-size:8px;white-space:nowrap}.stats,.products,.metrics{grid-template-columns:1fr}.timeline{padding-left:32px}.timeline::before{left:12px}.tl-phase .tp-period{position:static;margin-bottom:4px}.val-item{grid-template-columns:40px 1fr}.val-item .vd{grid-column:1/-1}.journal-grid{grid-template-columns:1fr}.nl-form{flex-direction:column}.nl-form input{border-right:1px solid var(--bdr);border-radius:2px}.nl-form button{border-radius:2px}.donut-wrap{flex-direction:column}.sns-grid{max-width:300px}}
  </style>
</head>
<body>

<!-- TOP NAV -->
<nav class="top-nav">
  <span class="logo">BRICKS</span>
  <div class="tabs">
    <button class="tab active" onclick="showPage('home')">Home</button>
    <button class="tab" onclick="showPage('brand')">Brand</button>
    <button class="tab" onclick="showPage('landing')">Landing</button>
    <button class="tab" onclick="showPage('products')">Products</button>
    <button class="tab" onclick="showPage('sns')">SNS</button>
    <button class="tab" onclick="showPage('bizplan')">Business</button>
  </div>
</nav>

<!-- ========== HOME ========== -->
<div class="page active" id="page-home">
  <!-- Cover -->
  <div class="cover">
    <div class="cover-bg"></div>
    <div class="cover-overlay"></div>
    <img src="/bricks/logo.png" alt="BRICKS" class="cover-logo">
    <div class="cover-tagline">Built to Last</div>
    <div class="cover-kr">쌓는 사람들의 브랜드</div>
    <div class="cover-meta">HESED CORP. — Brand Development Hub — 2026</div>
  </div>

  <!-- Status -->
  <div class="sec"><div class="wrap">
    <div class="sn sr">Project Status</div>
    <div class="st sr d1">프로젝트 현황</div>
    <div class="stats sr d2">
      <div class="stat"><div class="sv">6</div><div class="sl">산출물 완료</div></div>
      <div class="stat"><div class="sv">6</div><div class="sl">SKU 기획</div></div>
      <div class="stat cel"><div class="sv">Phase 0</div><div class="sl">현재 단계</div></div>
      <div class="stat gold"><div class="sv">2026.06</div><div class="sl">런칭 목표</div></div>
    </div>
  </div></div>

  <!-- Brand Identity Summary -->
  <div class="sec"><div class="wrap">
    <div class="sn sr">Brand Identity</div>
    <div class="st sr d1">브랜드 요약</div>
    <div class="brand-grid sr d2">
      <div class="brand-card">
        <h4>Brand</h4>
        <p><strong style="color:var(--sand);font-family:var(--fd);font-size:18px;letter-spacing:3px">BRICKS</strong><br><br>장인정신 기반 프리미엄 데일리 라이프스타일 브랜드<br><br><strong style="color:var(--sand)">Tagline:</strong> Built to Last<br><strong style="color:var(--sand)">슬로건:</strong> 쌓는 사람들의 브랜드<br><strong style="color:var(--sand)">타겟:</strong> 25-39세 도시 거주 MZ세대<br><strong style="color:var(--sand)">가치:</strong> Craft · Warmth · Endurance · Story</p>
      </div>
      <div class="brand-card">
        <h4>Design System</h4>
        <p><strong style="color:var(--sand)">Color Palette</strong></p>
        <div style="display:flex;gap:6px;margin:12px 0">
          <div style="width:28px;height:28px;border-radius:3px;background:#8B3A2A" title="#8B3A2A"></div>
          <div style="width:28px;height:28px;border-radius:3px;background:#A85040" title="#A85040"></div>
          <div style="width:28px;height:28px;border-radius:3px;background:#6B2A1E" title="#6B2A1E"></div>
          <div style="width:28px;height:28px;border-radius:3px;background:#E8A87C" title="#E8A87C"></div>
          <div style="width:28px;height:28px;border-radius:3px;background:#F5E6D3" title="#F5E6D3"></div>
          <div style="width:28px;height:28px;border-radius:3px;background:#C9A96E" title="#C9A96E"></div>
          <div style="width:28px;height:28px;border-radius:3px;background:#7BA298" title="#7BA298"></div>
        </div>
        <div style="margin-top:12px">
          <div style="font-family:var(--fd);font-size:16px;color:var(--sand);letter-spacing:2px">DM Serif Display</div>
          <div style="font-size:13px;color:var(--mu)">Noto Sans KR 본문</div>
          <div style="font-family:var(--fm);font-size:11px;color:var(--dim)">JetBrains Mono · Data</div>
          <div style="font-family:var(--fe);font-size:14px;color:var(--mu);font-style:italic">Cormorant Garamond</div>
        </div>
      </div>
      <div class="brand-card">
        <h4>Product Categories</h4>
        <p><strong style="color:var(--sand)">WEAR</strong> · 의류 — 티, 후디, 캡<br><strong style="color:var(--sand)">CARRY</strong> · 소품 — 토트, 파우치<br><strong style="color:var(--sand)">LIVE</strong> · 리빙 — 머그, 코스터, 캔들<br><strong style="color:var(--sand)">COLLECT</strong> · 컬렉터블 — 핀뱃지, 아트프린트<br><br><strong style="color:var(--sand)">Price Range:</strong> ₩38,000 ~ ₩178,000</p>
      </div>
      <div class="brand-card">
        <h4>Seasonal Roadmap</h4>
        <p><strong style="color:var(--brick)">SS26</strong> Foundation — 첫 번째 벽돌 (런칭)<br><span style="color:var(--dim)">FW26</span> Mortar — 접합 (콜라보레이션)<br><span style="color:var(--dim)">SS27</span> Kiln — 가마 (정제·한정판)<br><span style="color:var(--dim)">FW27</span> Wall — 벽 (풀 라인업 완성)<br><br><strong style="color:var(--sand)">Year 1:</strong> ₩180M 목표<br><strong style="color:var(--sand)">Launch:</strong> 6 SKU / 1,450 units</p>
      </div>
    </div>
  </div></div>
</div>

<!-- ========== BRAND ========== -->
<div class="page" id="page-brand">
  <div class="sec" style="border:none"><div class="wrap">
    <div class="sn sr">01 — Philosophy</div>
    <div class="st sr d1">Brand Philosophy</div>
    <div style="text-align:center;padding:48px 0 64px" class="sr d2">
      <div style="font-family:var(--fd);font-size:clamp(20px,3vw,32px);color:var(--sand);line-height:1.8;letter-spacing:1px">"하나의 벽돌이 세상을 바꾸진 못한다.<br>그러나 <em style="color:var(--brick);font-style:normal">쌓이면</em>,<br>집이 되고 길이 되고 성이 된다."</div>
      <div style="font-family:var(--fm);font-size:9px;letter-spacing:3px;color:var(--dim);margin-top:20px;text-transform:uppercase">— BRICKS Founding Philosophy</div>
    </div>
    <div style="background:var(--sf);border:1px solid var(--bdr);border-radius:4px;padding:40px 48px;position:relative;overflow:hidden" class="sr d3">
