  <!-- TOAST -->
  <div class="toast" id="toast"></div>
  <input type="file" id="importInput" accept=".json">

  <script>
    // ============================================
    // BRICKS Brand Hub v2 — App Logic
    // ============================================

    const PASS = 'bricks2026';
    const STORAGE_KEY = 'bricks-hub-v2';

    // ---- Floating Bricks (Hero) ----
    function initHeroBricks() {
      const container = document.getElementById('heroBricks');
      const count = 12;
      for (let i = 0; i < count; i++) {
        const el = document.createElement('div');
        el.className = 'float-brick';
        const w = 30 + Math.random() * 50;
        el.style.width = w + 'px';
        el.style.height = (w / 2) + 'px';
        el.style.left = (Math.random() * 100) + '%';
        el.style.top = (60 + Math.random() * 40) + '%';
        el.style.animationDelay = (Math.random() * 20) + 's';
        el.style.animationDuration = (15 + Math.random() * 15) + 's';
        container.appendChild(el);
      }
    }

    // ---- Scroll Reveal ----
    function initScrollReveal() {
      const sections = document.querySelectorAll('.section');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) e.target.classList.add('visible');
        });
      }, { threshold: 0.12 });
      sections.forEach(s => observer.observe(s));
    }

    // ---- Nav Dots ----
    function initNavDots() {
      const ids = ['sec-hero','sec-positioning','sec-story','sec-brick','sec-heritage','sec-season','sec-slogan','sec-contribution','sec-checklist','sec-discussion'];
      const container = document.getElementById('navDots');
      ids.forEach(id => {
        const dot = document.createElement('button');
        dot.className = 'nav-dot';
        dot.dataset.target = id;
        dot.addEventListener('click', () => {
          document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
        });
        container.appendChild(dot);
      });

      const dots = container.querySelectorAll('.nav-dot');
      const updateActive = () => {
        let closest = null, closestDist = Infinity;
        ids.forEach((id, i) => {
          const el = document.getElementById(id);
          if (!el) return;
          const dist = Math.abs(el.getBoundingClientRect().top);
          if (dist < closestDist) { closestDist = dist; closest = i; }
        });
        dots.forEach((d, i) => d.classList.toggle('active', i === closest));
      };
      window.addEventListener('scroll', updateActive, { passive: true });
      updateActive();
    }

    // ---- Topics Config ----
    const TOPICS = [
      { id:'first-collab', title:'시즌 1 콜라보 파트너', desc:'첫 벽돌을 누구와 놓을 것인가? 자체 IP? 외부 아티스트?', placeholder:'예: 자체 캐릭터로 시작하고, 시즌 2부터 외부 아티스트...' },
      { id:'first-product', title:'첫 제품 라인', desc:'어떤 카테고리로 시작? 아우터? 후드? 캡? 잡화?', placeholder:'예: 후드와 캡으로 시작, 벽돌 프레임이 잘 어울리는...' },
      { id:'price-position', title:'가격 포지셔닝', desc:'하이엔드 스트릿. 구체적인 가격대는?', placeholder:'예: 후드 기준 20-35만원대, PMO급 포지션...' },
      { id:'popup-concept', title:'팝업스토어 컨셉', desc:'벽돌·집·마을 서사를 공간으로 어떻게 번역할 것인가?', placeholder:'예: 입구에서 벽돌 한 장 받고, 나갈 때 마을 벽에 놓고 나오는...' },
      { id:'color-palette', title:'컬러 팔레트', desc:'브릭스를 대표하는 색상은?', placeholder:'예: 테라코타 + 차콜 + 청자색(전돌 모티브)...' },
      { id:'hidden-codes', title:'숨은 코드 설계', desc:'모르면 그래픽, 알면 메시지인 장치들', placeholder:'예: N° 시즌 넘버, 塼 한자, 연화문 패턴, QR...' },
      { id:'season1-theme', title:'시즌 1 주제', desc:'첫 집의 이름과 서사. 어떤 이야기를 지을 것인가?', placeholder:'예: "기초" — 첫 시즌이니까 말 그대로 기초를 놓는 이야기...' },
      { id:'reference-brands', title:'레퍼런스 브랜드', desc:'참고하고 싶은 브랜드, 분위기, 무드', placeholder:'예: PMO의 미니멀함 + Stussy의 콜라보 DNA + BOSS의 프리미엄...' },
      { id:'free-opinion', title:'자유 의견', desc:'브릭스에 대한 모든 생각', placeholder:'떠오르는 아이디어, 걱정, 기대 무엇이든...' }
    ];

    // ---- Data Layer ----
    function loadData() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) return JSON.parse(raw);
        // Migrate from v1
        const v1 = localStorage.getItem('bricks-hub-v1');
        if (v1) {
          const d = JSON.parse(v1);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(d));
          return d;
        }
        return { author:'', notes:{} };
      } catch { return { author:'', notes:{} }; }
    }

    function saveData(data) { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); }

    function addNote(topicId, content) {
      const data = loadData();
      if (!data.notes[topicId]) data.notes[topicId] = [];
      const note = {
        id: Date.now().toString(36) + Math.random().toString(36).slice(2,6),
        author: data.author,
        content: content.trim(),
        date: new Date().toISOString()
      };
      data.notes[topicId].push(note);
      saveData(data);
      return note;
    }

    function deleteNote(topicId, noteId) {
      const data = loadData();
      if (data.notes[topicId]) {
        data.notes[topicId] = data.notes[topicId].filter(n => n.id !== noteId);
        saveData(data);
      }
    }

    function getNotes(topicId) {
      const data = loadData();
      return (data.notes[topicId] || []).sort((a,b) => new Date(a.date) - new Date(b.date));
    }

    function getTotalNoteCount() {
      const data = loadData();
      return Object.values(data.notes).reduce((s,a) => s + a.length, 0);
    }

    // ---- Toast ----
    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.add('show');
      setTimeout(() => el.classList.remove('show'), 2500);
    }

    // ---- Format Date ----
    function formatDate(iso) {
      const d = new Date(iso);
      return `${d.getMonth()+1}/${d.getDate()} ${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}`;
    }

    function escapeHtml(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    // ---- Render Topics ----
    function renderTopics() {
      const container = document.getElementById('topicList');
      container.innerHTML = '';

      TOPICS.forEach(topic => {
        const notes = getNotes(topic.id);
        const card = document.createElement('div');
        card.className = 'topic-card';
        card.innerHTML = `
          <div class="topic-header" data-topic="${topic.id}">
            <div class="topic-header-left">
              <h3>${topic.title}</h3>
              <div class="topic-desc">${topic.desc}</div>
            </div>
            ${notes.length > 0 ? `<span class="topic-count">${notes.length}</span>` : ''}
            <span class="topic-arrow">&#9662;</span>
          </div>
          <div class="topic-body">
            <div class="topic-body-inner">
              <div class="notes-list" id="notes-${topic.id}">
                ${notes.length === 0
                  ? '<div class="empty-notes">아직 의견이 없습니다.</div>'
                  : notes.map(n => `
                    <div class="note-item">
                      <div class="note-meta">
                        <span class="note-author">${escapeHtml(n.author)}</span>
                        <span class="note-date">${formatDate(n.date)}</span>
                      </div>
                      <div class="note-content">${escapeHtml(n.content)}</div>
                      <button class="note-delete" data-topic="${topic.id}" data-note="${n.id}" title="삭제">&times;</button>
                    </div>
                  `).join('')
                }
              </div>
              <div class="note-input-wrap">
                <textarea id="input-${topic.id}" placeholder="${topic.placeholder}" rows="2"></textarea>
                <button class="note-submit" data-topic="${topic.id}">등록</button>
              </div>
            </div>
          </div>
        `;
        container.appendChild(card);
      });

      // Toggle
      document.querySelectorAll('.topic-header').forEach(h => {
        h.addEventListener('click', () => h.closest('.topic-card').classList.toggle('open'));
      });

      // Submit
      document.querySelectorAll('.note-submit').forEach(btn => {
        btn.addEventListener('click', () => {
          const tid = btn.dataset.topic;
          const ta = document.getElementById(`input-${tid}`);
          const content = ta.value.trim();
          const data = loadData();
          if (!data.author) { showToast('상단에서 이름을 먼저 선택해주세요.'); return; }
          if (!content) return;
          addNote(tid, content);
          ta.value = '';
          renderTopics();
          document.querySelectorAll('.topic-card').forEach(c => {
            if (c.querySelector(`[data-topic="${tid}"]`)) c.classList.add('open');
          });
          showToast('의견이 저장되었습니다.');
        });
      });

      // Delete
      document.querySelectorAll('.note-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const { topic, note } = btn.dataset;
          if (confirm('이 의견을 삭제할까요?')) {
            deleteNote(topic, note);
            renderTopics();
            document.querySelectorAll('.topic-card').forEach(c => {
              if (c.querySelector(`[data-topic="${topic}"]`)) c.classList.add('open');
            });
            showToast('삭제되었습니다.');
          }
        });
      });

      // Ctrl+Enter
      document.querySelectorAll('.note-input-wrap textarea').forEach(ta => {
        ta.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            ta.parentElement.querySelector('.note-submit').click();
          }
        });
      });
    }

    // ---- Gate ----
    function initGate() {
      const gate = document.getElementById('gate');
      const app = document.getElementById('app');
      const input = document.getElementById('gatePassword');
      const btn = document.getElementById('gateSubmit');
      const error = document.getElementById('gateError');

      if (sessionStorage.getItem('bricks-auth') === 'ok') {
        gate.classList.add('hidden');
        app.classList.add('active');
        return;
      }

      function tryAuth() {
        if (input.value === PASS) {
          sessionStorage.setItem('bricks-auth', 'ok');
          gate.classList.add('hidden');
          app.classList.add('active');
        } else {
          error.textContent = 'Access denied.';
          input.value = '';
          input.focus();
          setTimeout(() => error.textContent = '', 2000);
        }
      }
      btn.addEventListener('click', tryAuth);
      input.addEventListener('keydown', e => { if (e.key === 'Enter') tryAuth(); });
      input.focus();
    }

    // ---- Author ----
    function initAuthor() {
      const sel = document.getElementById('authorSelect');
      const data = loadData();
      if (data.author) sel.value = data.author;
      sel.addEventListener('change', () => {
        const data = loadData();
        data.author = sel.value;
        saveData(data);
        if (sel.value) showToast(`${sel.value}님으로 설정되었습니다.`);
      });
    }

    // ---- Export/Import ----
    function initTools() {
      document.getElementById('btnExport').addEventListener('click', () => {
        const data = loadData();
        const total = getTotalNoteCount();
        if (total === 0) { showToast('내보낼 의견이 없습니다.'); return; }
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `bricks-notes-${data.author||'unknown'}-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast(`${total}개 의견을 내보냈습니다.`);
      });

      document.getElementById('btnImport').addEventListener('click', () => {
        document.getElementById('importInput').click();
      });

      document.getElementById('importInput').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          try {
            const imported = JSON.parse(ev.target.result);
            const data = loadData();
            let count = 0;
            for (const [topic, notes] of Object.entries(imported.notes || {})) {
              if (!data.notes[topic]) data.notes[topic] = [];
              for (const note of notes) {
                if (!data.notes[topic].find(n => n.id === note.id)) {
                  data.notes[topic].push(note);
                  count++;
                }
              }
            }
            saveData(data);
            renderTopics();
            showToast(`${count}개 의견을 가져왔습니다.`);
          } catch { showToast('파일 형식이 올바르지 않습니다.'); }
        };
        reader.readAsText(file);
        e.target.value = '';
      });
    }

    // ---- Init ----
    document.addEventListener('DOMContentLoaded', () => {
      initGate();
      initAuthor();
      initTools();
      renderTopics();
      initHeroBricks();
      initScrollReveal();
      initNavDots();
    });
  </script>
</body>
</html>